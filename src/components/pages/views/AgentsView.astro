---
/**
 * AgentsView — the dedicated AI Agents landing page (`/agents` and `/<locale>/agents`).
 */
import PageLayout from '@/layouts/PageLayout.astro';
import Icon from '@/components/ui/primitives/Icon/Icon.astro';
import Button from '@/components/ui/form/Button/Button.astro';
import { Hero } from '@/components/hero';
import CtaBand from '@/components/patterns/CtaBand.astro';
import ProjectAgentsSection from '@/components/projects/ProjectAgentsSection.astro';
import { t, defaultLocale, localizedPath } from '@/i18n';

interface Props {
  locale?: string;
}

const { locale = defaultLocale } = Astro.props;

const contactUrl = localizedPath('/contact', locale);
const projectsUrl = localizedPath('/projects', locale);
---

<PageLayout
  title={t('projects.agents.title', locale)}
  description={t('projects.agents.lead', locale)}
  eagerReveal
  footerBackground="secondary"
>
  <Hero layout="centered" size="sm" class="isolate !pt-24 !pb-4" showHeroHalo>
    <h1 slot="title" class="!text-3xl sm:!text-4xl md:!text-5xl">
      {t('projects.agents.title', locale)}
    </h1>

    <p slot="description" class="!text-sm sm:!text-base max-w-2xl mx-auto">
      {t('projects.agents.lead', locale)}
    </p>
  </Hero>

  <!-- Constellation & Side-by-Side Spotlight Description -->
  <ProjectAgentsSection locale={locale} />

  <!-- CTA -->
  <section class="relative z-10 py-[var(--space-section-md)] bg-background">
    <CtaBand>
      <h2 class="font-display text-4xl font-bold text-foreground mb-4 text-balance">
        {t('projects.ctaHeading', locale)}
      </h2>
      <p class="text-lg text-foreground-muted mb-8 text-balance">
        {t('projects.ctaLead', locale)}
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <Button size="lg" href={contactUrl}>
          {t('projects.ctaPrimary', locale)}
          <Icon name="arrow-right" size="sm" />
        </Button>
        <Button size="lg" variant="outline" class="cta-btn-brand" href={projectsUrl}>
          {t('projects.title', locale)}
          <Icon name="arrow-right" size="sm" />
        </Button>
      </div>
    </CtaBand>
  </section>
</PageLayout>
