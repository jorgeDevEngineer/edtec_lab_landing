---
/**
 * AboutView — the About page body.
 *
 * Shared by the default-locale route (`/about`) and the locale-prefixed route
 * (`/<locale>/about`). All copy is read from the `pages.about.*` keys in the
 * locale dictionaries (`src/i18n/<locale>.json`) via `t()` / `tData()`, so
 * translating the page is a matter of editing JSON — no markup changes — and
 * any untranslated key falls back to the default locale automatically.
 *
 * Rendering with the default locale produces the same markup the page had
 * before this was extracted.
 */
import PageLayout from '@/layouts/PageLayout.astro';
import Icon from '@/components/ui/primitives/Icon/Icon.astro';
import Badge from '@/components/ui/data-display/Badge/Badge.astro';
import ProofTile from '@/components/ui/data-display/ProofTile/ProofTile.astro';
import { Hero } from '@/components/hero';
import { Image } from 'astro:assets';
import edtecTeamImg from '@/assets/about/edtec-team.jpg';
import edtecComiteReunionImg from '@/assets/about/edtec-comite-reunion.jpg';
import edtecCampusEquipoImg from '@/assets/about/edtec-campus-equipo.jpg';
import comiteCiideaImg from '@/assets/about/comite-ciidea.jpg';
import alianzasLogosImg from '@/assets/about/alianzas-logos.png';
import { t, tData, defaultLocale } from '@/i18n';

interface Props {
  /** Locale whose copy this page renders. Defaults to the site default. */
  locale?: string;
}

interface IconText {
  icon: string;
  title: string;
  description: string;
}

interface NewsArticle {
  tag: string;
  date: string;
  readTime: string;
  title: string;
  description: string;
  url: string;
  imageUrl: string;
}

const { locale = defaultLocale } = Astro.props;

const hero = tData<{
  badge: string;
  titleLead: string;
  description: string;
}>('pages.about.hero', locale)!;
const respaldos = tData<{
  badge: string;
  heading: string;
  lead: string;
  mainBadge: string;
  mainTitle: string;
  mainDescription: string;
  alliancesBadge: string;
  items: IconText[];
}>('pages.about.respaldos', locale)!;
const news = tData<{
  badge: string;
  heading: string;
  lead: string;
  readMore: string;
  source: string;
  items: NewsArticle[];
}>('pages.about.news', locale)!;

const heroSlides = [
  {
    src: edtecTeamImg,
    caption: 'Comité Técnico de EDTEC Lab y Jurado de la primera edición del concurso EDTEC 2026.',
  },
  {
    src: edtecCampusEquipoImg,
    caption: 'Equipo e investigadores de EDTEC Lab en el campus de la Universidad Católica Andrés Bello.',
  },
  {
    src: edtecComiteReunionImg,
    caption: 'Sesión de trabajo e integración interdisciplinaria del Comité Técnico de EDTEC Lab.',
  },
];
---
<PageLayout
  title={t('pages.about.meta.title', locale)}
  description={t('pages.about.meta.description', locale)}
  footerBackground="secondary"
>
  <Hero layout="centered" size="sm" class="isolate pb-[var(--space-section-md)]" showHeroHalo>
    <h1 slot="title">
      <span class="text-foreground [-webkit-text-fill-color:currentColor]">{hero.titleLead}</span>{' '}
      <span class="text-brand-500 [-webkit-text-fill-color:var(--color-brand-500)]">Innovación Educativa</span>
    </h1>

    <p slot="description" class="!text-balance">
      {hero.description}
    </p>

    <!-- Hero's default slot renders directly under the actions, inside the
         content column, which is `items-center text-center` on a centred
         layout — so this needs no centring of its own. -->
    <div class="mt-[calc(var(--space-section-gap)_-_var(--space-stack-lg))] w-full max-w-4xl mx-auto">
      <div
        id="about-hero-carousel"
        class="group relative overflow-hidden rounded-2xl border border-border shadow-2xl bg-card select-none"
      >
        <div class="relative aspect-[16/10] sm:aspect-[16/9] w-full overflow-hidden bg-zinc-900">
          {heroSlides.map((slide, index) => (
            <div
              data-about-slide={index}
              class:list={[
                'absolute inset-0 transition-opacity duration-700 ease-in-out',
                index === 0 ? 'opacity-100 z-10' : 'opacity-0 z-0 pointer-events-none',
              ]}
            >
              <Image
                src={slide.src}
                alt={t('pages.about.teamImageAlt', locale)}
                widths={[640, 960, 1280]}
                sizes="(max-width: 896px) 100vw, 896px"
                class="w-full h-full object-cover object-center"
                priority={index === 0}
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/75 via-black/20 to-transparent flex items-end p-5 sm:p-7 pb-12 sm:pb-12 pointer-events-none">
                <p class="text-white text-sm md:text-base font-medium drop-shadow-md text-left max-w-3xl">
                  {slide.caption}
                </p>
              </div>
            </div>
          ))}
        </div>

        <!-- Controles Laterales (Anterior / Siguiente) -->
        <button
          type="button"
          data-about-prev
          aria-label={t('common.previous', locale)}
          class="absolute left-3 sm:left-4 top-1/2 -translate-y-1/2 z-20 w-10 h-10 rounded-full bg-black/45 hover:bg-brand-500 text-white border border-white/20 backdrop-blur-md flex items-center justify-center transition-all shadow-lg cursor-pointer"
        >
          <Icon name="chevron-left" size="sm" />
        </button>

        <button
          type="button"
          data-about-next
          aria-label={t('common.next', locale)}
          class="absolute right-3 sm:right-4 top-1/2 -translate-y-1/2 z-20 w-10 h-10 rounded-full bg-black/45 hover:bg-brand-500 text-white border border-white/20 backdrop-blur-md flex items-center justify-center transition-all shadow-lg cursor-pointer"
        >
          <Icon name="chevron-right" size="sm" />
        </button>

        <!-- Indicadores inferiores -->
        <div class="absolute bottom-3.5 left-1/2 -translate-x-1/2 z-20 flex items-center gap-2 px-3 py-1.5 rounded-full bg-black/40 backdrop-blur-md border border-white/15">
          {heroSlides.map((_, index) => (
            <button
              type="button"
              data-about-dot={index}
              aria-label={t('common.next', locale)}
              class:list={[
                'h-2 rounded-full transition-all duration-300 cursor-pointer',
                index === 0 ? 'w-6 bg-brand-400' : 'w-2 bg-white/50 hover:bg-white/80',
              ]}
            />
          ))}
        </div>
      </div>
    </div>
  </Hero>

  <!-- Comité Organizador -->
  <section class="py-[var(--space-section-md)] bg-background border-t border-border">
    <div class="mx-auto max-w-6xl px-6 flex flex-col gap-10">
      <div class="flex flex-col items-center gap-4 text-center" data-reveal data-reveal-eager>
        <h2 class="font-display text-3xl md:text-4xl font-bold text-foreground text-balance">
          Comité Organizador
        </h2>
        <p class="text-lg text-foreground-muted max-w-2xl mx-auto text-balance">
          El equipo humano que impulsa la investigación aplicada, el desarrollo de competencias y de soluciones tecnológicas para la innovación curricular.
        </p>
      </div>

      <div class="relative overflow-hidden rounded-2xl border border-border bg-card shadow-xl" data-reveal>
        <Image
          src={comiteCiideaImg}
          alt={t('pages.about.comiteImageAlt', locale)}
          widths={[640, 1024, 1600]}
          sizes="(max-width: 1152px) 100vw, 1152px"
          class="w-full h-auto object-cover max-h-[580px]"
        />
        <div class="p-6 md:p-8 bg-background-secondary border-t border-border flex flex-col sm:flex-row sm:items-center justify-between gap-4">
          <div>
            <h3 class="font-display text-lg font-bold text-foreground">Comité organizador de la 1a edición del Concurso.</h3>
            <p class="text-sm text-foreground-muted">Centro de Investigación, Innovación y Desarrollo Académico (CIIDEA) & EDTEC Lab</p>
          </div>
          <span class="inline-flex items-center gap-1.5 text-xs font-semibold px-3 py-1.5 rounded-full bg-brand-500/10 text-brand-600 dark:text-brand-400 border border-brand-500/20">
            <Icon name="sparkles" size="xs" />
            Concurso EDTEC Lab 2026
          </span>
        </div>
      </div>
    </div>
  </section>

  <!-- Direcciones y Respaldo Institucional -->
  <section class="py-[var(--space-section-md)] bg-background-secondary border-t border-border">
    <div class="mx-auto max-w-6xl px-6 flex flex-col gap-10">
      <div class="flex flex-col items-center gap-4 text-center" data-reveal data-reveal-eager data-reveal-ease="smooth">
        <h2 class="font-display text-3xl md:text-4xl font-bold text-foreground text-balance">
          {respaldos.heading}
        </h2>
        <p class="text-lg text-foreground-muted max-w-3xl mx-auto text-balance">
          {respaldos.lead}
        </p>
      </div>

      <!-- Coordinación Principal & Vicerrectorado -->
      <div class="rounded-2xl border border-brand-500/30 bg-gradient-to-r from-brand-500/10 via-brand-500/5 to-transparent p-6 md:p-8 flex flex-col md:flex-row items-start md:items-center justify-between gap-6" data-reveal>
        <div class="flex items-start gap-4">
          <div class="w-12 h-12 rounded-xl bg-brand-500/20 text-brand-600 dark:text-brand-400 flex items-center justify-center shrink-0 mt-1">
            <Icon name="award" size="lg" />
          </div>
          <div>
            <span class="inline-block text-xs font-semibold uppercase tracking-wider text-brand-600 dark:text-brand-400 mb-1">
              {respaldos.mainBadge}
            </span>
            <h3 class="font-display text-xl md:text-2xl font-bold text-foreground">
              {respaldos.mainTitle}
            </h3>
            <p class="text-foreground-muted text-sm md:text-base mt-2 max-w-3xl leading-relaxed">
              {respaldos.mainDescription}
            </p>
          </div>
        </div>
      </div>

      <!-- Alianzas y Direcciones -->
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {respaldos.items.map((item, i) => (
          <ProofTile icon={item.icon} title={item.title} data-reveal data-reveal-delay={item.title === 'CIIDEA' ? undefined : (i % 3 || undefined)}>
            {item.description}
          </ProofTile>
        ))}
      </div>

      <!-- Banner de Logos Institucionales y Colaboradores -->
      <div class="rounded-2xl border border-border/80 bg-white dark:bg-zinc-900/90 p-4 sm:p-8 shadow-sm flex flex-col items-center justify-center gap-3" data-reveal>
        <span class="text-xs font-semibold uppercase tracking-wider text-foreground-muted text-center">
          Ecosistema Institucional y Alianzas Estratégicas
        </span>
        <div class="w-full flex items-center justify-center bg-white rounded-xl p-3 sm:p-6 ring-1 ring-black/5 dark:ring-white/10 shadow-inner">
          <Image
            src={alianzasLogosImg}
            alt="Logos de direcciones, centros y aliados que respaldan a EDTEC Lab"
            class="w-full max-w-4xl h-auto object-contain rounded-lg"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Novedades & Artículos de Prensa (El Ucabista) -->
  <section class="py-[var(--space-section-md)] bg-background border-t border-border">
    <div class="mx-auto max-w-6xl px-6 flex flex-col gap-10">
      <div class="flex flex-col items-center gap-3 text-center" data-reveal data-reveal-eager>
        <h2 class="font-display text-3xl md:text-4xl font-bold text-foreground text-balance">
          {news.heading}
        </h2>
        <p class="text-lg text-foreground-muted max-w-2xl mx-auto text-balance">
          {news.lead}
        </p>
      </div>

      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {news.items.map((item, index) => (
          <article
            class="group relative flex flex-col overflow-hidden rounded-2xl border border-border bg-card transition-all duration-300 hover:border-brand-500/50 hover:shadow-xl hover:-translate-y-1"
            data-reveal
            data-reveal-delay={index > 0 ? String(index % 3) : undefined}
          >
            <!-- Image Frame -->
            <div class="relative aspect-[16/10] w-full overflow-hidden bg-muted">
              <img
                src={item.imageUrl}
                alt={item.title}
                loading="lazy"
                class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/20 to-transparent"></div>
              
              <!-- Tag & Source pill -->
              <div class="absolute top-4 left-4 flex items-center gap-2">
                <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-blue-600 text-white shadow-md">
                  <Icon name="book-open" size="xs" />
                  {news.source}
                </span>
                <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium bg-black/60 text-white/90 backdrop-blur-sm">
                  {item.tag}
                </span>
              </div>

              <!-- Date & Read time overlay -->
              <div class="absolute bottom-3 left-4 right-4 flex items-center justify-between text-xs text-white/80">
                <span class="flex items-center gap-1">
                  <Icon name="calendar" size="xs" />
                  {item.date}
                </span>
                <span class="flex items-center gap-1">
                  <Icon name="clock" size="xs" />
                  {item.readTime}
                </span>
              </div>
            </div>

            <!-- Content -->
            <div class="flex flex-1 flex-col justify-between p-6">
              <div>
                <h3 class="font-display text-xl font-bold text-foreground group-hover:text-brand-500 transition-colors line-clamp-2">
                  <a href={item.url} target="_blank" rel="noopener noreferrer">
                    <span class="absolute inset-0 z-10" aria-hidden="true"></span>
                    {item.title}
                  </a>
                </h3>
                <p class="mt-3 text-sm text-foreground-muted line-clamp-3 leading-relaxed">
                  {item.description}
                </p>
              </div>

              <div class="mt-6 flex items-center justify-between pt-4 border-t border-border/70 text-xs font-semibold text-brand-600 dark:text-brand-400 group-hover:text-brand-500">
                <span>{news.readMore}</span>
                <Icon name="arrow-up-right" size="sm" class="transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5" />
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</PageLayout>

<style>
  details[open] > summary .faq-icon {
    transform: rotate(180deg);
  }
</style>

<script>
  function initAboutHeroCarousel() {
    const container = document.getElementById('about-hero-carousel');
    if (!container) return;

    const slides = container.querySelectorAll<HTMLElement>('[data-about-slide]');
    const dots = container.querySelectorAll<HTMLElement>('[data-about-dot]');
    const prevBtn = container.querySelector<HTMLElement>('[data-about-prev]');
    const nextBtn = container.querySelector<HTMLElement>('[data-about-next]');

    if (slides.length <= 1) return;

    let current = 0;
    let autoplayTimer: ReturnType<typeof setInterval> | null = null;

    const showSlide = (nextIndex: number) => {
      current = (nextIndex + slides.length) % slides.length;

      slides.forEach((slide, idx) => {
        if (idx === current) {
          slide.classList.remove('opacity-0', 'z-0', 'pointer-events-none');
          slide.classList.add('opacity-100', 'z-10');
        } else {
          slide.classList.remove('opacity-100', 'z-10');
          slide.classList.add('opacity-0', 'z-0', 'pointer-events-none');
        }
      });

      dots.forEach((dot, idx) => {
        if (idx === current) {
          dot.classList.remove('w-2', 'bg-white/50', 'hover:bg-white/80');
          dot.classList.add('w-6', 'bg-brand-400');
        } else {
          dot.classList.remove('w-6', 'bg-brand-400');
          dot.classList.add('w-2', 'bg-white/50', 'hover:bg-white/80');
        }
      });
    };

    const startAutoplay = () => {
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      stopAutoplay();
      autoplayTimer = setInterval(() => {
        showSlide(current + 1);
      }, 6000);
    };

    const stopAutoplay = () => {
      if (autoplayTimer) {
        clearInterval(autoplayTimer);
        autoplayTimer = null;
      }
    };

    prevBtn?.addEventListener('click', () => {
      showSlide(current - 1);
      startAutoplay();
    });

    nextBtn?.addEventListener('click', () => {
      showSlide(current + 1);
      startAutoplay();
    });

    dots.forEach((dot, idx) => {
      dot.addEventListener('click', () => {
        showSlide(idx);
        startAutoplay();
      });
    });

    container.addEventListener('mouseenter', stopAutoplay);
    container.addEventListener('mouseleave', startAutoplay);

    startAutoplay();
  }

  initAboutHeroCarousel();
  document.addEventListener('astro:after-swap', initAboutHeroCarousel);
</script>
