---
/**
 * AboutView — the About page body.
 *
 * Shared by the default-locale route (`/about`) and the locale-prefixed route
 * (`/<locale>/about`). All copy is read from the `pages.about.*` keys in the
 * locale dictionaries (`src/i18n/<locale>.json`) via `t()` / `tData()`, so
 * translating the page is a matter of editing JSON — no markup changes — and
 * any untranslated key falls back to the default locale automatically.
 *
 * Rendering with the default locale produces the same markup the page had
 * before this was extracted.
 */
import PageLayout from '@/layouts/PageLayout.astro';
import Icon from '@/components/ui/primitives/Icon/Icon.astro';
import Badge from '@/components/ui/data-display/Badge/Badge.astro';
import Card from '@/components/ui/data-display/Card/Card.astro';
import ProofTile from '@/components/ui/data-display/ProofTile/ProofTile.astro';
import Button from '@/components/ui/form/Button/Button.astro';
import { Hero } from '@/components/hero';
import { Image } from 'astro:assets';
import edtecTeamImg from '@/assets/about/edtec-team.jpg';
import comiteCiideaImg from '@/assets/about/comite-ciidea.jpg';
import TypingEffect from '@/components/ui/TypingEffect.astro';
import TechStack from '@/components/landing/TechStack.astro';
import CtaBand from '@/components/patterns/CtaBand.astro';
import { t, tData, defaultLocale } from '@/i18n';

interface Props {
  /** Locale whose copy this page renders. Defaults to the site default. */
  locale?: string;
}

interface IconText {
  icon: string;
  title: string;
  description: string;
}
interface FaqItem {
  question: string;
  answer: string;
}
interface FaqCard {
  icon: string;
  title: string;
  items: FaqItem[];
}
interface TitleText {
  title: string;
  text: string;
}

const { locale = defaultLocale } = Astro.props;

const GITHUB_URL = 'https://github.com/hansmartensdev/astro-rocket';

const hero = tData<{
  badge: string;
  titleLead: string;
  typingWords: string[];
  /** Shorter set for phones (below sm), dropping the one word wide enough to clip at the hero size. */
  typingWordsMobile: string[];
  description: string;
}>('pages.about.hero', locale)!;
const respaldos = tData<{
  badge: string;
  heading: string;
  lead: string;
  mainBadge: string;
  mainTitle: string;
  mainDescription: string;
  alliancesBadge: string;
  items: IconText[];
}>('pages.about.respaldos', locale)!;
const stack = tData<{ badge: string; title: string; description: string }>('pages.about.stack', locale)!;
const faq = tData<{ badge: string; heading: string; lead: string; cards: FaqCard[] }>('pages.about.faq', locale)!;
const openSource = tData<{
  badge: string;
  heading: string;
  description: string;
  button: string;
  cards: TitleText[];
}>('pages.about.openSource', locale)!;
const cta = tData<{ badge: string; heading: string; description: string; button: string }>('pages.about.cta', locale)!;
---
<PageLayout
  title={t('pages.about.meta.title', locale)}
  description={t('pages.about.meta.description', locale)}
  footerBackground="secondary"
>
  <Hero layout="centered" size="sm" class="isolate pb-[var(--space-section-md)]" showHeroHalo>
    <Badge slot="badge" variant="brand" pill>
      <Icon name="rocket" size="sm" />
      {hero.badge}
    </Badge>
    <h1 slot="title">
      <span class="text-foreground [-webkit-text-fill-color:currentColor]">{hero.titleLead}</span><br />
      <span class="text-brand-500 [-webkit-text-fill-color:var(--color-brand-500)] sm:hidden">
        <TypingEffect words={hero.typingWordsMobile} />
      </span>
      <span class="text-brand-500 [-webkit-text-fill-color:var(--color-brand-500)] hidden sm:inline">
        <TypingEffect words={hero.typingWords} />
      </span>
    </h1>

    <p slot="description" class="!text-balance">
      {hero.description}
    </p>

    <!-- Hero's default slot renders directly under the actions, inside the
         content column, which is `items-center text-center` on a centred
         layout — so this needs no centring of its own.

         Spacing is the same two-value scale the hero already runs on:
         --space-section-md at the section edge, carried by the pb override
         above, and --space-section-gap between the copy and the image.
         --space-stack-lg is the block value and leaves an image this size
         crowding the copy; a section-edge value above it would put a
         boundary-scale gap inside a section.

         The subtraction is why this is a calc rather than the token on its
         own. Hero gives the description slot mb-[var(--space-stack-lg)],
         because a row of buttons normally follows it. Nothing does here, so
         that 32px stacks under the paragraph before this margin even starts,
         and the token alone renders 80px at desktop and 64px on a phone
         against the 48 and 32 it is meant to be. Taking --space-stack-lg back
         off lands the total on the token at every width: 16 + 32 = 48 at
         desktop, 0 + 32 = 32 on a phone. Delete the subtraction if the
         paragraph ever gains buttons after it.

         max-w-4xl also decides which of the two canvases renders, because
         ProjectImageSVG switches on the image's own width rather than the
         viewport's: 896px keeps the wide one, a phone's ~382px column takes
         the tall one. -->
    <div class="mt-[calc(var(--space-section-gap)_-_var(--space-stack-lg))] w-full max-w-4xl mx-auto">
      <div class="relative overflow-hidden rounded-2xl border border-border shadow-2xl bg-card">
        <Image
          src={edtecTeamImg}
          alt={t('pages.about.teamImageAlt', locale)}
          widths={[640, 960, 1280]}
          sizes="(max-width: 896px) 100vw, 896px"
          class="w-full h-auto object-cover max-h-[520px]"
          priority
        />
        <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent flex items-end p-6 pointer-events-none">
          <p class="text-white text-sm md:text-base font-medium drop-shadow-md">
            Comunidad e Innovadores del Laboratorio de Tecnologías Emergentes para la Educación (EDTEC Lab UCAB)
          </p>
        </div>
      </div>
    </div>
  </Hero>

  <!-- Equipo Directivo, Comité Organizador y Becas de Trabajo CIIDEA -->
  <section class="py-[var(--space-section-md)] bg-background border-t border-border">
    <div class="mx-auto max-w-6xl px-6 flex flex-col gap-10">
      <div class="flex flex-col items-center gap-4 text-center" data-reveal data-reveal-eager>
        <Badge variant="brand" pill>
          <Icon name="users" size="sm" />
          Comité & Mentorías
        </Badge>
        <h2 class="font-display text-3xl md:text-4xl font-bold text-foreground text-balance">
          Comité Organizador y Becas de Trabajo CIIDEA
        </h2>
        <p class="text-lg text-foreground-muted max-w-2xl mx-auto text-balance">
          El motor humano que impulsa la investigación, el diseño instruccional y el acompañamiento tecnológico de los proyectos en la UCAB.
        </p>
      </div>

      <div class="relative overflow-hidden rounded-2xl border border-border bg-card shadow-xl" data-reveal>
        <Image
          src={comiteCiideaImg}
          alt={t('pages.about.comiteImageAlt', locale)}
          widths={[640, 1024, 1600]}
          sizes="(max-width: 1152px) 100vw, 1152px"
          class="w-full h-auto object-cover max-h-[580px]"
        />
        <div class="p-6 md:p-8 bg-background-secondary border-t border-border flex flex-col sm:flex-row sm:items-center justify-between gap-4">
          <div>
            <h3 class="font-display text-lg font-bold text-foreground">Comité Organizador y Becarios de Investigación CIIDEA</h3>
            <p class="text-sm text-foreground-muted">Centro de Investigación, Innovación y Desarrollo Académico (CIIDEA) & EDTEC Lab</p>
          </div>
          <span class="inline-flex items-center gap-1.5 text-xs font-semibold px-3 py-1.5 rounded-full bg-brand-500/10 text-brand-600 dark:text-brand-400 border border-brand-500/20">
            <Icon name="sparkles" size="xs" />
            Concurso EDTEC Lab 2026
          </span>
        </div>
      </div>
    </div>
  </section>

  <!-- Direcciones y Respaldo Institucional -->
  <section class="py-[var(--space-section-md)] bg-background-secondary border-t border-border">
    <div class="mx-auto max-w-6xl px-6 flex flex-col gap-10">
      <div class="flex flex-col items-center gap-4 text-center" data-reveal data-reveal-eager data-reveal-ease="smooth">
        <div class="flex flex-col items-center gap-6">
          <Badge variant="brand" pill>
            <Icon name="shield-check" size="sm" />
            {respaldos.badge}
          </Badge>
          <h2 class="font-display text-3xl md:text-4xl font-bold text-foreground text-balance">
            {respaldos.heading}
          </h2>
        </div>
        <p class="text-lg text-foreground-muted max-w-3xl mx-auto text-balance">
          {respaldos.lead}
        </p>
      </div>

      <!-- Coordinación Principal & Vicerrectorado -->
      <div class="rounded-2xl border border-brand-500/30 bg-gradient-to-r from-brand-500/10 via-brand-500/5 to-transparent p-6 md:p-8 flex flex-col md:flex-row items-start md:items-center justify-between gap-6" data-reveal>
        <div class="flex items-start gap-4">
          <div class="w-12 h-12 rounded-xl bg-brand-500/20 text-brand-600 dark:text-brand-400 flex items-center justify-center shrink-0 mt-1">
            <Icon name="award" size="lg" />
          </div>
          <div>
            <span class="inline-block text-xs font-semibold uppercase tracking-wider text-brand-600 dark:text-brand-400 mb-1">
              {respaldos.mainBadge}
            </span>
            <h3 class="font-display text-xl md:text-2xl font-bold text-foreground">
              {respaldos.mainTitle}
            </h3>
            <p class="text-foreground-muted text-sm md:text-base mt-2 max-w-3xl leading-relaxed">
              {respaldos.mainDescription}
            </p>
          </div>
        </div>
      </div>

      <!-- Alianzas y Direcciones -->
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {respaldos.items.map((item, i) => (
          <ProofTile icon={item.icon} title={item.title} data-reveal data-reveal-delay={i % 3 || undefined}>
            {item.description}
          </ProofTile>
        ))}
      </div>
    </div>
  </section>

  <!-- Tech Stack -->
  <TechStack
    badge={stack.badge}
    badgeIcon="wrench"
    title={stack.title}
    description={stack.description}
    background="secondary"
  />

  <!-- FAQ. The id is what the footer's "Got questions?" column links to;
       without it there was no way to point at this section. -->
  <section id="faq" class="scroll-mt-24 py-[var(--space-section-md)] bg-background border-t border-border">
    <div class="mx-auto max-w-6xl px-6 flex flex-col gap-8">
      <div class="flex flex-col items-center gap-4 text-center" data-reveal>
        <div class="flex flex-col items-center gap-6">
          <Badge variant="brand" pill>
            <Icon name="info" size="sm" />
            {faq.badge}
          </Badge>
          <h2 class="font-display text-3xl md:text-4xl font-bold text-foreground">
            {faq.heading}
          </h2>
        </div>
        <p class="text-lg text-foreground-muted max-w-2xl mx-auto text-balance">
          {faq.lead}
        </p>
      </div>

      <div class="grid gap-6 md:grid-cols-2">
        {faq.cards.map((card, cardIndex) => (
          <Card variant="elevated" padding="lg" data-reveal data-reveal-delay={cardIndex + 1}>
            <div class="flex items-center gap-3 pb-4 border-b border-border">
              <div class="w-11 h-11 rounded-lg bg-gradient-to-br from-brand-500/20 to-brand-500/5 flex items-center justify-center text-brand-500 shrink-0">
                <Icon name={card.icon} size="md" />
              </div>
              <h3 class="font-display text-base font-semibold text-foreground">{card.title}</h3>
            </div>
            <div class="w-full">
              {card.items.map((item) => (
                <details class="border-b border-border last:border-0" name={`faq-${cardIndex}`}>
                  <summary class="flex w-full items-center justify-between text-sm py-4 text-left font-medium text-foreground transition-colors hover:text-foreground-secondary cursor-pointer list-none [&::-webkit-details-marker]:hidden">
                    {item.question}
                    <Icon name="chevron-down" size="sm" class="faq-icon shrink-0 text-foreground-muted transition-transform duration-200" />
                  </summary>
                  <div class="pb-4 text-sm text-foreground-muted leading-relaxed" set:html={item.answer} />
                </details>
              ))}
            </div>
          </Card>
        ))}
      </div>
    </div>
  </section>

  <!-- Open Source -->
  <section class="py-[var(--space-section-md)] bg-background-secondary border-t border-border">
    <div class="mx-auto max-w-6xl px-6">
      <div class="grid gap-8 sm:gap-10 glitch:grid-cols-2 glitch:items-center">
        <!-- Text -->
        <div class="flex flex-col gap-4 sm:items-center sm:text-center glitch:items-start glitch:justify-center glitch:text-left" data-reveal data-reveal-ease="smooth">
          <Badge variant="brand" pill class="self-start sm:self-center glitch:self-start">
            <Icon name="github" size="sm" />
            {openSource.badge}
          </Badge>
          <h2 class="font-display text-3xl md:text-4xl font-bold text-foreground">
            {openSource.heading}
          </h2>
          <p class="text-lg text-foreground-muted leading-relaxed sm:max-w-xl sm:mx-auto glitch:max-w-none glitch:mx-0">
            {openSource.description}
          </p>
          <div class="flex flex-wrap gap-4 self-start sm:self-center sm:justify-center glitch:self-start mt-2">
            <Button variant="brand-outline" size="lg" href={GITHUB_URL} target="_blank" rel="noopener noreferrer">
              {openSource.button}
              <Icon name="arrow-right" size="sm" />
            </Button>
          </div>
        </div>

        <!-- Info card -->
        <div class="flex flex-col h-full" data-reveal data-reveal-delay="1" data-reveal-ease="smooth">
          <Card variant="elevated" padding="lg" class="flex-1 flex flex-col justify-center gap-6">
            {openSource.cards.map((card) => (
              <div class="flex flex-col gap-2">
                <h3 class="text-base font-semibold text-foreground">{card.title}</h3>
                <p class="text-sm text-foreground-muted leading-relaxed" set:html={card.text} />
              </div>
            ))}
          </Card>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="relative z-10 py-[var(--space-section-md)] bg-background border-t border-border">
    <CtaBand>
      <h2 class="font-display text-4xl font-bold text-foreground mb-4 text-balance">
        {cta.heading}
      </h2>
      <p class="text-lg text-foreground-muted mb-8 text-balance">
        {cta.description}
      </p>
      <Button size="lg" href={GITHUB_URL} target="_blank" rel="noopener noreferrer">
        {cta.button}
        <Icon name="arrow-right" size="sm" />
      </Button>
    </CtaBand>
  </section>
</PageLayout>

<style>
  details[open] > summary .faq-icon {
    transform: rotate(180deg);
  }
</style>
