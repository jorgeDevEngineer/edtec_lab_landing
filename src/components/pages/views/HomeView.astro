---
/**
 * HomeView — the landing page body.
 *
 * Shared by the default-locale route (`/`) and the locale-prefixed route
 * (`/<locale>`). All copy is read from `pages.home.*` via `t()` / `tData()`,
 * and internal links are localized with `localizedPath`. Featured projects and
 * posts are loaded for the active locale and fall back to the default locale so
 * the sections are never empty on a locale that hasn't translated its content
 * yet. Each card links to the URL of the locale the content actually belongs
 * to, so a fallback (default-locale) item still points at a real page.
 */
import LandingLayout from '@/layouts/LandingLayout.astro';
import { Hero } from '@/components/hero';
import Button from '@/components/ui/form/Button/Button.astro';
import Badge from '@/components/ui/data-display/Badge/Badge.astro';
import Card from '@/components/ui/data-display/Card/Card.astro';
import ProofTile from '@/components/ui/data-display/ProofTile/ProofTile.astro';
import Icon from '@/components/ui/primitives/Icon/Icon.astro';
import BlogCard from '@/components/blog/BlogCard.astro';
import CtaBand from '@/components/patterns/CtaBand.astro';
import StackMarquee from '@/components/landing/StackMarquee.astro';
import HeroCosineParticles from '@/components/effects/HeroCosineParticles.astro';
import { getCollection } from 'astro:content';
import siteConfig from '@/config/site.config';
import { getPostUrl, getPublishedPosts } from '@/lib/blog';
import { getVisibleProjects } from '@/lib/projects';
import ProjectCard from '@/components/projects/ProjectCard.astro';
import { t, tData, defaultLocale, localizedPath } from '@/i18n';

interface Props {
  /** Locale whose copy and content this page renders. Defaults to the site default. */
  locale?: string;
}

interface IconCard {
  icon: string;
  title: string;
  description: string;
}
interface Testimonial {
  quote: string;
  name: string;
  role: string;
}

const { locale = defaultLocale } = Astro.props;

// Featured projects for this locale, falling back to the default locale so the
// section is never empty on a locale that hasn't translated its projects yet.
let projectItems = await getVisibleProjects(locale);
if (projectItems.length === 0 && locale !== defaultLocale) {
  projectItems = await getVisibleProjects(defaultLocale);
}
const featuredProjects = projectItems
  .filter((p) => p.data.featured)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 4);

let postItems = await getPublishedPosts(locale);
if (postItems.length === 0 && locale !== defaultLocale) {
  postItems = await getPublishedPosts(defaultLocale);
}
const posts = [...postItems]
  .sort((a, b) => {
    if (a.data.featured !== b.data.featured) return a.data.featured ? -1 : 1;
    return b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf();
  })
  .slice(0, 4);

// Hero marquee — a focused subset of the tech stack, in this order, pulled from
// the same `stack` collection so icons and links stay single-sourced. Seven logos
// are wide enough to fill the constrained hero width and loop seamlessly on their
// own; the Tech-stack section further down still shows the full stack.
const heroStackOrder = ['Astro', 'Tailwind CSS', 'TypeScript', 'React', 'GitHub', 'Vercel', 'Claude'];
const heroStackItems = (await getCollection('stack'))
  .filter((e) => heroStackOrder.includes(e.data.name))
  .sort((a, b) => heroStackOrder.indexOf(a.data.name) - heroStackOrder.indexOf(b.data.name))
  .map((e) => ({
    name: e.data.name,
    icon: e.data.icon,
    url: e.data.url,
    version: e.data.version,
    colorOklch: e.data.colorOklch,
  }));

const hero = tData<{
  badge: string;
  titleLine1: string;
  titleLine2: string;
  titleLine3: string;
  description: string;
  /** Shorter variant shown below the `sm` breakpoint so the hero stays compact on phones. */
  descriptionMobile: string;
  github: string;
  getStarted: string;
}>('pages.home.hero', locale)!;
const workWithMe = tData<{ badge: string; heading: string; lead: string; cards: IconCard[]; cta: string }>(
  'pages.home.workWithMe',
  locale
)!;
const servicesSection = tData<{ badge: string; heading: string; lead: string; learnMore: string; cards: IconCard[] }>(
  'pages.home.services',
  locale
)!;
const portfolio = tData<{ badge: string; heading: string; lead: string; viewAll: string }>('pages.home.portfolio', locale)!;
const testimonials = tData<{ badge: string; heading: string; lead: string; items: Testimonial[] }>(
  'pages.home.testimonials',
  locale
)!;
const aboutTeaser = tData<{
  badge: string;
  headingLine1: string;
  headingLine2: string;
  para2: string;
  moreAboutMe: string;
  statsIntro: string;
  stat1: string;
  stat2: string;
  stat3: string;
  basedIn: string;
}>('pages.home.aboutTeaser', locale)!;
const blogSection = tData<{ badge: string; heading: string; viewAll: string }>('pages.home.blog', locale)!;
const cta = tData<{ badge: string; heading: string; description: string; primary: string; secondary: string }>(
  'pages.home.cta',
  locale
)!;

const servicesUrl = localizedPath('/services', locale);
const projectsUrl = localizedPath('/projects', locale);
const aboutUrl = localizedPath('/about', locale);
const contactUrl = localizedPath('/contact', locale);
const blogUrl = localizedPath('/blog', locale);
// The getting-started guide lives at the default-locale URL; link there so the
// CTA always resolves even before a locale has translated that post.
const getStartedUrl = '/blog/astro-rocket-getting-started';

// About-teaser copy with the configured location woven in (mirrors the original
// page's conditional). Falls back to a location-free sentence when no city is set.
const city = siteConfig.address?.city;
const country = siteConfig.address?.country;
const location = city ? (country ? `${city}, ${country}` : city) : '';
const aboutPara1 = location
  ? t('pages.home.aboutTeaser.para1WithLocation', locale, { location })
  : t('pages.home.aboutTeaser.para1NoLocation', locale);
const basedInDisplay = `${city ?? 'Your City'}${country ? `, ${country}` : ''}`;
---

<LandingLayout
  title={t('pages.home.meta.title', locale)}
  description={t('pages.home.meta.description', locale)}
  includePersonSchema={true}
  includeProfessionalServiceSchema={true}
>
  <!-- Hero -->
  <!-- data-header-flip-anchor: the floating header keeps its over-the-hero
       look until this section is nearly out from under it. See the flip
       threshold in Header.astro.

       data-bar-color: Safari on iOS floats a translucent toolbar over the foot
       of the screen and tints it from the BODY's background. This hero is dark
       in both colour modes while the body under it is white in light mode,
       which draws a white strip across the foot of it. The theme script paints
       the body this colour while the hero covers that edge, and clears it
       after. Same value as --bar-color in global.css, which ends the hero's
       gradient. See `paintBody` in BaseLayout.astro. -->
  <Hero layout="centered" size="xl" class="hero-dark-gradient" fullHeight data-header-flip-anchor data-bar-color="#000">

    {/* 12.6vw fills the mobile column (~95-98% at 320-390px), sized to the
        English demo strings — translated hero copy is the site owner's to
        refit. The 3rem cap keeps the size continuous with sm:text-5xl at
        the 640px boundary. */}
    <h1 slot="title" class="!text-[clamp(1.75rem,8vw,2.75rem)] sm:!text-4xl md:!text-5xl lg:!text-6xl font-bold tracking-tight">
      <span class="text-brand-600 dark:text-foreground [-webkit-text-fill-color:currentColor]">{hero.titleLine1}</span><br />
      <span class="text-brand-600 dark:text-foreground [-webkit-text-fill-color:currentColor]">{hero.titleLine2}</span>{' '}
      <span class="text-brand-500 [-webkit-text-fill-color:currentColor]">{hero.titleLine3}</span>
    </h1>

    <p slot="description" class="!text-balance max-w-2xl mx-auto text-base sm:text-lg">
      <span class="sm:hidden">{hero.descriptionMobile}</span>
      <span class="hidden sm:inline">{hero.description}</span>
    </p>

    <Fragment slot="actions">
      <Button size="lg" href={aboutUrl}>
        {hero.github}
        <Icon name="arrow-right" size="sm" />
      </Button>
    </Fragment>

    <!-- Partículas con trayectoria de coseno alargado flotando suavemente -->
    <HeroCosineParticles />

  </Hero>



  <!-- Epicentro de la Innovación Curricular -->
  <section class="relative z-10 py-[var(--space-section-md)] bg-background-secondary border-t border-border">
    <div class="mx-auto max-w-5xl px-6 flex flex-col gap-10" data-reveal>
      <div class="flex flex-col items-center gap-4 text-center">
        <h2 class="font-display text-3xl md:text-5xl font-bold text-foreground max-w-3xl leading-tight">
          El epicentro de la innovación curricular en la <span class="text-brand-500">UCAB</span>
        </h2>
      </div>

      <div class="grid gap-8 md:grid-cols-3">
        <div class="bg-background rounded-2xl p-7 border border-border flex flex-col gap-4 shadow-sm hover:border-brand-500/50 transition-all">
          <div class="w-12 h-12 rounded-xl bg-brand-500/10 flex items-center justify-center text-brand-500">
            <Icon name="target" size="lg" />
          </div>
          <h3 class="font-display text-xl font-bold text-foreground">Innovación Curricular</h3>
          <p class="text-foreground-muted leading-relaxed text-sm md:text-base">
            El Laboratorio de Educación Tecnológica (EDTEC Lab) es el epicentro de la innovación curricular de la Universidad Católica Andrés Bello. Nuestro propósito es cerrar la brecha entre las tecnologías emergentes y el aula de clases.
          </p>
        </div>

        <div class="bg-background rounded-2xl p-7 border border-border flex flex-col gap-4 shadow-sm hover:border-brand-500/50 transition-all">
          <div class="w-12 h-12 rounded-xl bg-brand-500/10 flex items-center justify-center text-brand-500">
            <Icon name="cpu" size="lg" />
          </div>
          <h3 class="font-display text-xl font-bold text-foreground">Tecnologías de Vanguardia</h3>
          <p class="text-foreground-muted leading-relaxed text-sm md:text-base">
            Desde el desarrollo de asistentes inteligentes hasta la implementación de simuladores virtuales, trabajamos junto a docentes y estudiantes para crear un ecosistema educativo más eficiente, innovador, inclusivo y vanguardista.
          </p>
        </div>

        <div class="bg-background rounded-2xl p-7 border border-border flex flex-col gap-4 shadow-sm hover:border-brand-500/50 transition-all">
          <div class="w-12 h-12 rounded-xl bg-brand-500/10 flex items-center justify-center text-brand-500">
            <Icon name="network" size="lg" />
          </div>
          <h3 class="font-display text-xl font-bold text-foreground">Conocimiento Aplicado</h3>
          <p class="text-foreground-muted leading-relaxed text-sm md:text-base">
            En el laboratorio EDTEC convergen distintas unidades académicas y centros de investigación de la UCAB, con el fin de generar conocimiento aplicado y soluciones reales para los retos del aprendizaje universitario.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Comunidad EDTEC -->
  <section id="participar" class="relative z-10 py-[var(--space-section-md)] bg-background border-t border-border">
    <div class="mx-auto max-w-5xl px-6 flex flex-col gap-10" data-reveal>
      <div class="flex flex-col items-center gap-4 text-center">
        <h2 class="font-display text-3xl md:text-5xl font-bold text-foreground text-balance">
          ¿Cómo formar parte de nuestra comunidad?
        </h2>
        <p class="text-lg text-foreground-muted max-w-2xl mx-auto text-balance">
          El EDTEC Lab es un espacio abierto para toda la comunidad ucabista.
        </p>
      </div>

      <div class="grid gap-8 md:grid-cols-2">
        <!-- Tarjeta Para Estudiantes -->
        <div class="relative overflow-hidden rounded-2xl border border-border bg-background-secondary/50 p-8 flex flex-col gap-6 shadow-sm hover:border-brand-500/40 transition-all">
          <div class="flex items-center gap-4">
            <div class="w-12 h-12 rounded-xl bg-orange-500/10 text-orange-500 flex items-center justify-center font-bold">
              <Icon name="graduation-cap" size="lg" />
            </div>
            <div>
              <span class="text-xs uppercase tracking-wider font-semibold text-orange-500">Para Estudiantes</span>
              <h3 class="font-display text-2xl font-bold text-foreground">Laboratorio Experiencial</h3>
            </div>
          </div>

          <div class="flex flex-col gap-4 text-foreground-muted leading-relaxed">
            <p>
              Si quieres aprender a desarrollar soluciones tecnológicas sin importar qué carrera estás estudiando, contáctanos y súmate a nuestras sesiones de laboratorio experiencial.
            </p>
          </div>
        </div>

        <!-- Tarjeta Para Profesores -->
        <div class="relative overflow-hidden rounded-2xl border border-border bg-background-secondary/50 p-8 flex flex-col gap-6 shadow-sm hover:border-brand-500/40 transition-all">
          <div class="flex items-center gap-4">
            <div class="w-12 h-12 rounded-xl bg-indigo-500/10 text-indigo-500 flex items-center justify-center font-bold">
              <Icon name="presentation" size="lg" />
            </div>
            <div>
              <span class="text-xs uppercase tracking-wider font-semibold text-indigo-500">Para Profesores</span>
              <h3 class="font-display text-2xl font-bold text-foreground">Implementa en tu Cátedra</h3>
            </div>
          </div>

          <div class="flex flex-col gap-4 text-foreground-muted leading-relaxed">
            <p>
              Si quieres implementar alguna de las herramientas presentadas en tus asignaturas, solo debes contactarnos y acordamos una reunión para determinar el alcance y realizar la inducción respectiva.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Proyectos -->
  <section id="work" class="relative z-10 py-[var(--space-section-md)] bg-background-secondary border-t border-border">
    <div class="mx-auto max-w-6xl px-6 flex flex-col gap-14">
      <div class="flex flex-col items-center gap-4 text-center" data-reveal>
        <h2 class="font-display text-3xl md:text-5xl font-bold text-foreground">
          Nuestros Proyectos
        </h2>
        <p class="text-lg text-foreground-muted max-w-2xl mx-auto text-balance">
          Iniciativas y desarrollos tecnológicos orientados a transformar la experiencia formativa en la UCAB.
        </p>
      </div>

      <!-- Bloque 1: Proyectos Implementados y Avanzados -->
      <div class="flex flex-col gap-6">
        <div class="border-b border-border pb-3 flex flex-col sm:flex-row sm:items-end justify-between gap-2">
          <div>
            <h3 class="font-display text-2xl font-bold text-foreground">
              Proyectos Implementados y Avanzados
            </h3>
            <p class="text-sm text-foreground-muted">
              Soluciones activas que ya están siendo probadas en diversas unidades académicas y centros de investigación.
            </p>
          </div>
        </div>

        <div class="grid gap-6 md:grid-cols-3">
          <!-- PredixIA -->
          <div class="rounded-2xl border border-border bg-background p-7 flex flex-col gap-4 shadow-sm hover:border-brand-500/40 transition-all" data-reveal>
            <div class="w-12 h-12 rounded-xl bg-brand-500/10 text-brand-500 flex items-center justify-center">
              <Icon name="cpu" size="lg" />
            </div>
            <div>
              <span class="text-xs font-semibold text-brand-500 uppercase tracking-wider">Inteligencia Artificial</span>
              <h4 class="font-display text-2xl font-bold text-foreground mt-1">PredixIA</h4>
            </div>
            <p class="text-foreground-muted leading-relaxed text-sm md:text-base">
              Asistente de ventas y análisis de datos potenciado con inteligencia artificial.
            </p>
          </div>

          <!-- Nova Academy -->
          <div class="rounded-2xl border border-border bg-background p-7 flex flex-col gap-4 shadow-sm hover:border-brand-500/40 transition-all" data-reveal data-reveal-delay="1">
            <div class="w-12 h-12 rounded-xl bg-brand-500/10 text-brand-500 flex items-center justify-center">
              <Icon name="sparkles" size="lg" />
            </div>
            <div>
              <span class="text-xs font-semibold text-brand-500 uppercase tracking-wider">Competencias Digitales</span>
              <h4 class="font-display text-2xl font-bold text-foreground mt-1">Nova Academy</h4>
            </div>
            <p class="text-foreground-muted leading-relaxed text-sm md:text-base">
              Rutas de aprendizaje para el desarrollo de competencias digitales y uso de IA en el ámbito universitario.
            </p>
          </div>

          <!-- Diálogo`s -->
          <div class="rounded-2xl border border-border bg-background p-7 flex flex-col gap-4 shadow-sm hover:border-brand-500/40 transition-all" data-reveal data-reveal-delay="2">
            <div class="w-12 h-12 rounded-xl bg-brand-500/10 text-brand-500 flex items-center justify-center">
              <Icon name="bot" size="lg" />
            </div>
            <div>
              <span class="text-xs font-semibold text-brand-500 uppercase tracking-wider">Aprendizaje Activo</span>
              <h4 class="font-display text-2xl font-bold text-foreground mt-1">Diálogo`s</h4>
            </div>
            <p class="text-foreground-muted leading-relaxed text-sm md:text-base">
              Asistente conversacional para facilitar el aprendizaje activo mediante el diálogo guiado con contenidos curriculares.
            </p>
          </div>
        </div>
      </div>

      <!-- Bloque 2: Proyectos en Desarrollo (Concurso EDTEC Lab) -->
      <div class="flex flex-col gap-6 pt-4">
        <div class="border-b border-border pb-3 flex flex-col sm:flex-row sm:items-end justify-between gap-2">
          <div>
            <h3 class="font-display text-2xl font-bold text-foreground">
              Proyectos en Desarrollo — Concurso EDTEC Lab
            </h3>
            <p class="text-sm text-foreground-muted">
              Iniciativas interdisciplinarias de profesores y estudiantes en proceso de mentoría y desarrollo de prototipos.
            </p>
          </div>
        </div>

        <!-- Banner contextual del Concurso EDTEC Lab 2026 -->
        <div class="rounded-2xl border border-border bg-background p-6 md:p-8 flex flex-col lg:flex-row items-start lg:items-center justify-between gap-6 shadow-sm" data-reveal>
          <div class="flex-1 space-y-2">
            <div class="flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-brand-500">
              <Icon name="trophy" size="sm" />
              1er Concurso EDTEC Lab 2026 · Crea, innova y transforma
            </div>
            <h4 class="font-display text-xl font-bold text-foreground">
              Propuestas seleccionadas rumbo al Demo Day
            </h4>
            <p class="text-sm md:text-base text-foreground-muted leading-relaxed">
              Tras el cierre de postulaciones, los equipos multidisciplinarios seleccionados avanzan a las etapas de mentorías y sprints de desarrollo para construir soluciones de tecnología educativa (EDTEC) en asignaturas del plan de estudios de la UCAB.
            </p>
          </div>
          <a
            href="https://sites.google.com/ucab.edu.ve/concurso-edteclab-2026/inicio"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl border border-brand-500/40 text-brand-600 dark:text-brand-400 font-semibold text-sm hover:bg-brand-500/10 transition-colors shrink-0"
          >
            Bases y próximas ediciones
            <Icon name="arrow-up-right" size="xs" />
          </a>
        </div>

        <!-- Proyectos del concurso en desarrollo -->
        <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          <!-- Fray Tempus -->
          <div class="rounded-2xl border border-border bg-background p-7 flex flex-col gap-4 shadow-sm hover:border-brand-500/40 transition-all" data-reveal>
            <div class="w-12 h-12 rounded-xl bg-purple-500/10 text-purple-600 dark:text-purple-400 flex items-center justify-center">
              <Icon name="hourglass" size="lg" />
            </div>
            <div>
              <span class="text-xs font-semibold text-purple-600 dark:text-purple-400 uppercase tracking-wider">Escape Room Inmersivo</span>
              <h4 class="font-display text-2xl font-bold text-foreground mt-1">Fray Tempus</h4>
              <p class="text-xs text-brand-500 font-medium">Laberinto del Tiempo®</p>
            </div>
            <p class="text-foreground-muted leading-relaxed text-sm md:text-base">
              Escape Room interactivo en Genially sobre la evolución histórica y el futuro de la jornada laboral, promoviendo el aprendizaje activo y el pensamiento crítico.
            </p>
            <div class="pt-2 border-t border-border/60 text-xs text-foreground-muted flex flex-col gap-1">
              <span><strong>Equipo:</strong> María Estela Mangia, Jeanette Da Silva, Claudia Medina</span>
              <span><strong>Mentores:</strong> Nidia Marcano, Oswaldo Sánchez</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Comité Técnico -->
  <section class="relative z-10 py-[var(--space-section-md)] bg-background-secondary border-t border-border">
    <div class="mx-auto max-w-5xl px-6 flex flex-col gap-10" data-reveal>
      <div class="flex flex-col items-center gap-4 text-center">
        <h2 class="font-display text-3xl md:text-5xl font-bold text-foreground">
          Comité Técnico
        </h2>
        <p class="text-lg text-foreground-muted max-w-2xl mx-auto text-balance">
          Un equipo multidisciplinario que garantiza el rigor académico y la viabilidad de cada proyecto.
        </p>
      </div>

      <div class="grid gap-6 md:grid-cols-2">
        <div class="rounded-2xl border border-border bg-background p-8 flex flex-col gap-4 shadow-sm hover:border-brand-500/40 transition-all">
          <div class="w-12 h-12 rounded-xl bg-brand-500/10 text-brand-500 flex items-center justify-center">
            <Icon name="users" size="lg" />
          </div>
          <h3 class="font-display text-xl font-bold text-foreground">Equipo Interdisciplinario</h3>
          <p class="text-foreground-muted leading-relaxed">
            El comité técnico está compuesto por el equipo de profesores investigadores del CIIDEA, profesores de las escuelas de Ingeniería Industrial, Informática y Telecomunicaciones, las escuelas de Educación y Psicología, así como el Centro de Innovación Educativa y el Instituto de Estudios Humanísticos.
          </p>
        </div>

        <div class="rounded-2xl border border-border bg-background p-8 flex flex-col gap-4 shadow-sm hover:border-brand-500/40 transition-all">
          <div class="w-12 h-12 rounded-xl bg-brand-500/10 text-brand-500 flex items-center justify-center">
            <Icon name="building" size="lg" />
          </div>
          <h3 class="font-display text-xl font-bold text-foreground">Unidades Aliadas</h3>
          <p class="text-foreground-muted leading-relaxed">
            Adicionalmente, según la naturaleza de cada proyecto, se integran unidades aliadas como el Centro de Innovación y Emprendimiento, el Centro de Investigación y Desarrollo de Ingeniería, el Centro de Estudios en Línea, la Dirección de Transferencia, las Academias, entre otras.
          </p>
        </div>
      </div>

      <!-- Compromiso ético -->
      <div class="rounded-2xl border border-border-strong bg-background p-6 md:p-8 flex flex-col sm:flex-row items-center gap-5 shadow-sm text-center sm:text-left">
        <div class="w-12 h-12 rounded-xl bg-emerald-500/10 text-emerald-500 flex items-center justify-center shrink-0">
          <Icon name="award" size="lg" />
        </div>
        <div class="flex-1">
          <p class="text-foreground-muted text-sm md:text-base leading-relaxed">
            Todos los proyectos de EDTEC Lab declaran cumplir con el{' '}
            <a
              href="https://investigacion.ucab.edu.ve/wp-content/uploads/2024/05/CODIGO-DE-ETICA-DE-LA-INVESTIGACION-UCAB-REVISION-22-SEPTIEMBRE-2023.pdf"
              target="_blank"
              rel="noopener noreferrer"
              class="font-semibold text-brand-500 hover:text-brand-600 underline underline-offset-4 transition-colors inline-flex items-center gap-1"
            >
              Código de Ética de la Investigación de la Universidad Católica Andrés Bello
              <Icon name="arrow-up-right" size="xs" />
            </a>.
          </p>
        </div>
      </div>
    </div>
  </section>





  <!-- CTA -->
