---
/**
 * ProjectAgentsSection — showcases specialized academic AI agents with a
 * distinctive "AI Console / Neural Roster" aesthetic so they stand out from
 * full-scale project cards while participating in the live name search filter.
 */
import Badge from '@/components/ui/data-display/Badge/Badge.astro';
import Icon from '@/components/ui/primitives/Icon/Icon.astro';
import { t, tData, defaultLocale } from '@/i18n';

interface AgentItem {
  name: string;
  author: string;
  icon: string;
  domain: string;
  purpose: string;
  bullets?: string[];
}

interface Props {
  locale?: string;
}

const { locale = defaultLocale } = Astro.props;

const agents = tData<AgentItem[]>('projects.agents.items', locale) ?? [];
const authorLabel = t('projects.agents.authorLabel', locale);
const statusBadge = t('projects.agents.statusBadge', locale);
---

{agents.length > 0 && (
  <section
    class="relative overflow-hidden py-16 bg-background border-t border-border"
    data-agents-section
  >
    <!-- Subtle ambient background glow -->
    <div
      class="pointer-events-none absolute left-1/2 top-0 -translate-x-1/2 h-72 w-[42rem] rounded-full bg-brand-500/5 blur-3xl dark:bg-brand-500/10"
      aria-hidden="true"
    />

    <div class="relative z-10 mx-auto max-w-6xl px-6">
      <!-- Section Header -->
      <div class="mx-auto max-w-2xl text-center mb-12" data-reveal>
        <div class="mb-3 flex justify-center">
          <Badge variant="brand" pill>
            <Icon name="bot" size="xs" />
            {t('projects.agents.badge', locale)}
          </Badge>
        </div>

        <h2 class="font-display text-3xl sm:text-4xl font-bold tracking-tight text-foreground mb-3">
          {t('projects.agents.title', locale)}
        </h2>

        <p class="text-sm sm:text-base text-foreground-muted leading-relaxed">
          {t('projects.agents.lead', locale)}
        </p>
      </div>

      <!-- Agents Bento / Console Grid -->
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-6">
        {agents.map((agent, index) => {
          const isWide = (agent.bullets && agent.bullets.length > 0) || index === 0;
          return (
            <article
              class:list={[
                'agent-card group relative flex flex-col rounded-2xl border border-brand-500/25 bg-background-secondary/70 p-6 sm:p-7 transition-all duration-300 hover:-translate-y-1 hover:border-brand-500/70 hover:shadow-xl',
                isWide ? 'md:col-span-2 lg:col-span-6' : 'lg:col-span-3'
              ]}
              data-project-card
              data-project-title={agent.name}
              data-reveal
              data-reveal-delay={index % 2 || undefined}
            >
              <!-- Top accent line -->
              <div
                class="pointer-events-none absolute inset-x-0 top-0 h-1 rounded-t-2xl bg-gradient-to-r from-brand-500/40 via-brand-500 to-brand-400/40 opacity-75 transition-opacity duration-300 group-hover:opacity-100"
                aria-hidden="true"
              />

              <!-- Terminal / Agent Header Bar -->
              <div class="flex flex-wrap items-center justify-between gap-2 pb-4 mb-4 border-b border-border/70">
                <div class="flex items-center gap-2">
                  <span class="relative flex h-2.5 w-2.5">
                    <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                    <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-emerald-500"></span>
                  </span>
                  <span class="font-mono text-[11px] font-semibold uppercase tracking-wider text-brand-600 dark:text-brand-400">
                    {statusBadge} // {String(index + 1).padStart(2, '0')}
                  </span>
                </div>

                <span class="inline-flex items-center gap-1.5 rounded-md bg-brand-500/10 px-2.5 py-0.5 text-xs font-medium text-brand-700 dark:text-brand-300 border border-brand-500/20">
                  {agent.domain}
                </span>
              </div>

              <!-- Agent Identity + Author -->
              <div class="flex items-start gap-4 mb-4">
                <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-gradient-to-br from-brand-500/20 to-brand-500/5 text-brand-500 border border-brand-500/30 shadow-sm transition-transform duration-300 group-hover:scale-105">
                  <Icon name={agent.icon} size="lg" />
                </div>

                <div class="min-w-0 flex-1">
                  <h3 class="font-display text-xl sm:text-2xl font-bold text-foreground tracking-tight group-hover:text-brand-600 dark:group-hover:text-brand-400 transition-colors">
                    {agent.name}
                  </h3>
                  <p class="mt-1 flex items-center gap-1.5 text-xs sm:text-sm font-medium text-foreground-muted">
                    <Icon name="user-check" size="xs" class="text-brand-500" />
                    <span>{authorLabel}: <strong class="font-semibold text-foreground">{agent.author}</strong></span>
                  </p>
                </div>
              </div>

              <!-- Agent Purpose & Structured Pillars -->
              <div class="flex-1 rounded-xl bg-background/80 border border-border/60 p-4 sm:p-5">
                <p class="text-sm text-foreground-muted leading-relaxed">
                  {agent.purpose}
                </p>

                {agent.bullets && agent.bullets.length > 0 && (
                  <ol class="mt-4 grid gap-2.5 sm:grid-cols-2">
                    {agent.bullets.map((bullet, bIdx) => (
                      <li class="flex items-start gap-2.5 rounded-lg border border-brand-500/20 bg-brand-500/[0.04] p-3 text-xs sm:text-sm text-foreground">
                        <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-brand-500/15 font-mono text-[11px] font-bold text-brand-600 dark:text-brand-400">
                          {bIdx + 1}
                        </span>
                        <span class="leading-snug">{bullet}</span>
                      </li>
                    ))}
                  </ol>
                )}
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </section>
)}

<style>
  @media (prefers-reduced-motion: reduce) {
    .agent-card .animate-ping {
      animation: none;
    }
  }
</style>
