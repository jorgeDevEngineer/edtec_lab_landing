---
/**
 * ProjectAgentsSection — interactive floating cloud ("Constellation") of
 * specialized academic AI agents.
 *
 * Instead of another boxy card grid, the five agents float at organic heights
 * inside a spacious cloud canvas with subtle orbital rings and connecting
 * paths. Clicking or focusing any floating agent pill smoothly updates the
 * central spotlight stage below with that agent's full purpose and pillars.
 */
import Badge from '@/components/ui/data-display/Badge/Badge.astro';
import Icon from '@/components/ui/primitives/Icon/Icon.astro';
import { t, tData, defaultLocale } from '@/i18n';

interface AgentItem {
  name: string;
  author: string;
  icon: string;
  domain: string;
  purpose: string;
  bullets?: string[];
}

interface Props {
  locale?: string;
}

const { locale = defaultLocale } = Astro.props;

const agents = tData<AgentItem[]>('projects.agents.items', locale) ?? [];
const authorLabel = t('projects.agents.authorLabel', locale);

// Organic vertical offsets and gentle float timing so the pills feel like a
// living cloud rather than a rigid row.
const cloudOffsets = [
  'lg:-translate-y-4',
  'lg:translate-y-5',
  'lg:-translate-y-6',
  'lg:translate-y-4',
  'lg:-translate-y-2',
];
---

{agents.length > 0 && (
  <section
    class="agents-cloud-section relative overflow-hidden py-20 bg-background border-t border-border"
    data-agents-section
  >
    <!-- Ambient atmospheric cloud backdrop -->
    <div
      class="pointer-events-none absolute inset-0 overflow-hidden"
      aria-hidden="true"
    >
      <div class="
        absolute left-1/2 top-1/3 -translate-x-1/2 -translate-y-1/2
        h-[26rem] w-[54rem] rounded-full
        bg-gradient-to-r from-brand-500/10 via-brand-400/15 to-brand-500/10
        blur-3xl dark:from-brand-500/15 dark:via-brand-400/20 dark:to-brand-500/15
      " />
      <!-- Subtle orbital rings -->
      <div class="
        hidden md:block absolute left-1/2 top-[44%] -translate-x-1/2 -translate-y-1/2
        w-[46rem] h-[16rem] rounded-[100%]
        border border-dashed border-brand-500/20 dark:border-brand-400/20
      " />
      <div class="
        hidden lg:block absolute left-1/2 top-[44%] -translate-x-1/2 -translate-y-1/2
        w-[62rem] h-[21rem] rounded-[100%]
        border border-brand-500/10 dark:border-brand-400/10
      " />
    </div>

    <div class="relative z-10 mx-auto max-w-6xl px-6">
      <!-- Section Header -->
      <div class="mx-auto max-w-2xl text-center mb-10" data-reveal>
        <div class="mb-3 flex justify-center">
          <Badge variant="brand" pill>
            <Icon name="sparkles" size="xs" />
            {t('projects.agents.badge', locale)}
          </Badge>
        </div>

        <h2 class="font-display text-3xl sm:text-4xl font-bold tracking-tight text-foreground mb-3">
          {t('projects.agents.title', locale)}
        </h2>

        <p class="text-sm sm:text-base text-foreground-muted leading-relaxed">
          {t('projects.agents.lead', locale)}
        </p>
      </div>

      <!-- Floating Cloud Canvas -->
      <div
        class="relative mx-auto max-w-5xl py-6 lg:py-10"
        role="tablist"
        aria-label={t('projects.agents.title', locale)}
        data-agents-cloud
      >
        <div class="flex flex-wrap items-center justify-center gap-4 sm:gap-6 lg:gap-7">
          {agents.map((agent, index) => (
            <div
              class:list={[
                'agent-node-wrap transition-transform duration-500',
                cloudOffsets[index % cloudOffsets.length],
              ]}
              data-project-card
              data-project-title={agent.name}
              data-agent-node={index}
            >
              <button
                type="button"
                role="tab"
                aria-selected={index === 0 ? 'true' : 'false'}
                aria-controls={`agent-panel-${index}`}
                id={`agent-tab-${index}`}
                data-agent-trigger={index}
                data-active={index === 0 ? 'true' : 'false'}
                style={`--float-delay: ${index * -1.3}s;`}
                class="
                  agent-cloud-pill group relative flex items-center gap-3.5
                  rounded-full px-5 py-3.5 sm:px-6 sm:py-4
                  bg-card/90 backdrop-blur-md
                  border border-brand-500/30
                  shadow-md hover:shadow-xl
                  transition-all duration-300 cursor-pointer
                  hover:-translate-y-1 hover:border-brand-500
                  data-[active=true]:border-brand-500
                  data-[active=true]:bg-brand-500/10
                  data-[active=true]:dark:bg-brand-500/20
                  data-[active=true]:shadow-xl
                  data-[active=true]:scale-105
                  focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500
                "
              >
                <span class="
                  flex h-11 w-11 shrink-0 items-center justify-center rounded-full
                  bg-gradient-to-br from-brand-500/20 to-brand-500/5
                  text-brand-500 border border-brand-500/25
                  transition-all duration-300
                  group-hover:scale-110
                  group-data-[active=true]:bg-brand-500
                  group-data-[active=true]:text-white
                  group-data-[active=true]:border-brand-500
                ">
                  <Icon name={agent.icon} size="md" />
                </span>

                <div class="text-left pr-1">
                  <span class="block font-display text-base sm:text-lg font-bold text-foreground leading-tight">
                    {agent.name}
                  </span>
                  <span class="block text-xs text-foreground-muted mt-0.5">
                    {agent.author}
                  </span>
                </div>
              </button>
            </div>
          ))}
        </div>
      </div>

      <!-- Central Spotlight Stage (displays the selected floating agent) -->
      <div class="relative mx-auto mt-4 max-w-3xl" data-agents-stage>
        {agents.map((agent, index) => (
          <div
            id={`agent-panel-${index}`}
            role="tabpanel"
            aria-labelledby={`agent-tab-${index}`}
            data-agent-panel={index}
            class:list={[
              'agent-spotlight rounded-3xl border border-brand-500/30 bg-card/95 backdrop-blur-xl p-7 sm:p-9 shadow-2xl transition-all duration-300',
              index === 0 ? 'block' : 'hidden',
            ]}
          >
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-5 mb-5 border-b border-border">
              <div class="flex items-center gap-4">
                <div class="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl bg-brand-500/15 text-brand-500 border border-brand-500/30">
                  <Icon name={agent.icon} size="lg" />
                </div>
                <div>
                  <div class="flex flex-wrap items-center gap-2.5">
                    <h3 class="font-display text-2xl sm:text-3xl font-bold text-foreground">
                      {agent.name}
                    </h3>
                    <span class="inline-flex items-center rounded-full bg-brand-500/10 px-3 py-0.5 text-xs font-medium text-brand-700 dark:text-brand-300 border border-brand-500/20">
                      {agent.domain}
                    </span>
                  </div>
                  <p class="mt-1 text-sm text-foreground-muted">
                    {authorLabel}: <strong class="font-semibold text-foreground">{agent.author}</strong>
                  </p>
                </div>
              </div>
            </div>

            <p class="text-base sm:text-lg text-foreground leading-relaxed">
              {agent.purpose}
            </p>

            {agent.bullets && agent.bullets.length > 0 && (
              <ul class="mt-5 grid gap-3 sm:grid-cols-2">
                {agent.bullets.map((bullet) => (
                  <li class="flex items-start gap-2.5 rounded-2xl border border-brand-500/20 bg-background-secondary/70 p-3.5 text-sm text-foreground">
                    <Icon name="check-circle-2" size="sm" class="mt-0.5 text-brand-500 shrink-0" />
                    <span class="leading-snug">{bullet}</span>
                  </li>
                ))}
              </ul>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>
)}

<style>
  @keyframes agent-float {
    0%, 100% {
      transform: translateY(0px);
    }
    50% {
      transform: translateY(-7px);
    }
  }

  .agent-cloud-pill {
    animation: agent-float 5.5s ease-in-out infinite;
    animation-delay: var(--float-delay, 0s);
  }

  .agent-cloud-pill:hover,
  .agent-cloud-pill[data-active="true"] {
    animation-play-state: paused;
  }

  @media (prefers-reduced-motion: reduce) {
    .agent-cloud-pill {
      animation: none;
    }
  }
</style>

<script>
  function initAgentsCloud() {
    const sections = document.querySelectorAll<HTMLElement>(
      '[data-agents-section]:not([data-agents-init])'
    );

    sections.forEach((section) => {
      section.setAttribute('data-agents-init', 'true');

      const triggers = Array.from(
        section.querySelectorAll<HTMLButtonElement>('[data-agent-trigger]')
      );
      const panels = Array.from(
        section.querySelectorAll<HTMLElement>('[data-agent-panel]')
      );
      const nodes = Array.from(
        section.querySelectorAll<HTMLElement>('[data-agent-node]')
      );

      const activateAgent = (targetIndex: number) => {
        triggers.forEach((btn, idx) => {
          const isActive = idx === targetIndex;
          btn.dataset.active = isActive ? 'true' : 'false';
          btn.setAttribute('aria-selected', isActive ? 'true' : 'false');
        });

        panels.forEach((panel, idx) => {
          panel.classList.toggle('hidden', idx !== targetIndex);
          panel.classList.toggle('block', idx === targetIndex);
        });
      };

      triggers.forEach((btn, idx) => {
        btn.addEventListener('click', () => activateAgent(idx));
        btn.addEventListener('mouseenter', () => activateAgent(idx));
      });

      // Keep the spotlight stage synced if the user filters agents via the search bar
      const observer = new MutationObserver(() => {
        const visibleIndices = nodes
          .map((node, idx) => (!node.classList.contains('hidden') ? idx : -1))
          .filter((idx) => idx !== -1);

        if (visibleIndices.length > 0) {
          const currentActive = triggers.findIndex((t) => t.dataset.active === 'true');
          if (!visibleIndices.includes(currentActive)) {
            activateAgent(visibleIndices[0]);
          }
        }
      });

      nodes.forEach((node) => {
        observer.observe(node, { attributes: true, attributeFilter: ['class'] });
      });
    });
  }

  initAgentsCloud();
  document.addEventListener('astro:after-swap', initAgentsCloud);
</script>
