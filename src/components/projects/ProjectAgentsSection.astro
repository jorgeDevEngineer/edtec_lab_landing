---
/**
 * ProjectAgentsSection — interactive floating cloud ("Constellation") of
 * specialized academic AI agents.
 *
 * Layout:
 * - Desktop (`lg+`): Two-column split layout. The floating constellation cloud
 *   lives on the left and the spotlight detail panel sits immediately to the
 *   right so visitors can read every agent's description without scrolling.
 * - Mobile / Tablet (`< lg`): Compact horizontal/wrapped pill cloud on top with
 *   the spotlight detail card directly underneath, fitting comfortably on
 *   small screens without horizontal overflow or layout shifts.
 * - All 5 agent spotlight panels share a single CSS grid cell (`col-start-1
 *   row-start-1`) so switching agents cross-fades in place with zero height
 *   change or scroll jumping.
 */
import Icon from '@/components/ui/primitives/Icon/Icon.astro';
import { t, tData, defaultLocale } from '@/i18n';

interface AgentItem {
  name: string;
  author: string;
  icon: string;
  domain: string;
  purpose: string;
  bullets?: string[];
}

interface Props {
  locale?: string;
  showHeader?: boolean;
}

const { locale = defaultLocale, showHeader = false } = Astro.props;

const agents = tData<AgentItem[]>('projects.agents.items', locale) ?? [];
const authorLabel = t('projects.agents.authorLabel', locale);

const cloudOffsets = [
  'lg:-translate-x-2 lg:-translate-y-1',
  'lg:translate-x-3 lg:translate-y-2',
  'lg:translate-x-1 lg:-translate-y-1',
  'lg:-translate-x-3 lg:translate-y-1',
  'lg:translate-x-2 lg:translate-y-0',
];
---

{agents.length > 0 && (
  <section
    class="agents-cloud-section relative overflow-hidden py-8 sm:py-12 lg:py-14 bg-background-secondary border-t border-border"
    data-agents-section
  >
    <!-- Ambient atmospheric cloud backdrop -->
    <div
      class="pointer-events-none absolute inset-0 overflow-hidden"
      aria-hidden="true"
    >
      <div class="
        absolute left-1/4 top-1/2 -translate-x-1/2 -translate-y-1/2
        h-[24rem] w-[38rem] rounded-full
        bg-gradient-to-r from-brand-500/10 via-brand-400/15 to-brand-500/10
        blur-3xl dark:from-brand-500/15 dark:via-brand-400/20 dark:to-brand-500/15
      " />
    </div>

    <div class="relative z-10 mx-auto max-w-6xl px-4 sm:px-6">
      {showHeader && (
        <div class="mx-auto max-w-2xl text-center mb-8" data-reveal>
          <h2 class="font-display text-3xl sm:text-4xl font-bold tracking-tight text-foreground mb-3">
            {t('projects.agents.title', locale)}
          </h2>
          <p class="text-sm sm:text-base text-foreground-muted leading-relaxed">
            {t('projects.agents.lead', locale)}
          </p>
        </div>
      )}

      <!-- Side-by-side on desktop (constellation left, description right), stacked cleanly on mobile -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-10 items-center">
        <!-- Left column: Floating Cloud Constellation -->
        <div
          class="lg:col-span-5 relative py-2 sm:py-4 lg:py-6"
          role="tablist"
          aria-label={t('projects.agents.title', locale)}
          data-agents-cloud
        >
          <!-- Subtle orbital ring behind the cloud on desktop -->
          <div
            class="pointer-events-none hidden lg:block absolute inset-2 rounded-[100%] border border-dashed border-brand-500/20 dark:border-brand-400/20"
            aria-hidden="true"
          />

          <div class="relative z-10 flex flex-wrap items-center justify-center gap-2.5 sm:gap-3.5 lg:gap-4">
            {agents.map((agent, index) => (
              <div
                class:list={[
                  'agent-node-wrap transition-transform duration-500',
                  cloudOffsets[index % cloudOffsets.length],
                ]}
                data-project-card
                data-project-title={agent.name}
                data-agent-node={index}
              >
                <button
                  type="button"
                  role="tab"
                  aria-selected={index === 0 ? 'true' : 'false'}
                  aria-controls={`agent-panel-${index}`}
                  id={`agent-tab-${index}`}
                  data-agent-trigger={index}
                  data-active={index === 0 ? 'true' : 'false'}
                  style={`--float-delay: ${index * -1.3}s;`}
                  class="
                    agent-cloud-pill group relative flex items-center gap-2.5 sm:gap-3
                    rounded-full px-3.5 py-2.5 sm:px-5 sm:py-3
                    bg-card/95 backdrop-blur-md
                    border border-brand-500/30
                    shadow-sm hover:shadow-lg
                    transition-all duration-300 cursor-pointer
                    hover:-translate-y-0.5 hover:border-brand-500
                    data-[active=true]:border-brand-500
                    data-[active=true]:bg-brand-500/10
                    data-[active=true]:dark:bg-brand-500/20
                    data-[active=true]:shadow-lg
                    data-[active=true]:scale-[1.03]
                    focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500
                  "
                >
                  <span class="
                    flex h-8 w-8 sm:h-10 sm:w-10 shrink-0 items-center justify-center rounded-full
                    bg-gradient-to-br from-brand-500/20 to-brand-500/5
                    text-brand-500 border border-brand-500/25
                    transition-all duration-300
                    group-hover:scale-105
                    group-data-[active=true]:bg-brand-500
                    group-data-[active=true]:text-white
                    group-data-[active=true]:border-brand-500
                  ">
                    <Icon name={agent.icon} size="sm" />
                  </span>

                  <div class="text-left pr-1">
                    <span class="block font-display text-sm sm:text-base font-bold text-foreground leading-tight">
                      {agent.name}
                    </span>
                    <span class="block text-[11px] sm:text-xs text-foreground-muted mt-0.5 line-clamp-1">
                      {agent.author}
                    </span>
                  </div>
                </button>
              </div>
            ))}
          </div>
        </div>

        <!-- Right column: Fixed-height stacked Spotlight Stage (zero layout shift, smooth fade/pop) -->
        <div
          class="lg:col-span-7 agent-stage-stack relative grid items-center"
          data-agents-stage
        >
          {agents.map((agent, index) => (
            <div
              id={`agent-panel-${index}`}
              role="tabpanel"
              aria-labelledby={`agent-tab-${index}`}
              aria-hidden={index === 0 ? 'false' : 'true'}
              data-agent-panel={index}
              data-active={index === 0 ? 'true' : 'false'}
              class="
                agent-spotlight col-start-1 row-start-1
                rounded-2xl sm:rounded-3xl border border-brand-500/30 bg-card/95 backdrop-blur-xl
                p-5 sm:p-7 lg:p-8 shadow-xl
              "
            >
              <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-4 mb-4 border-b border-border">
                <div class="flex items-center gap-3.5">
                  <div class="flex h-11 w-11 sm:h-13 sm:w-13 shrink-0 items-center justify-center rounded-2xl bg-brand-500/15 text-brand-500 border border-brand-500/30">
                    <Icon name={agent.icon} size="md" />
                  </div>
                  <div>
                    <div class="flex flex-wrap items-center gap-2">
                      <h2 class="font-display text-xl sm:text-2xl font-bold text-foreground">
                        {agent.name}
                      </h2>
                      <span class="inline-flex items-center rounded-full bg-brand-500/10 px-2.5 py-0.5 text-xs font-medium text-brand-700 dark:text-brand-300 border border-brand-500/20">
                        {agent.domain}
                      </span>
                    </div>
                    <p class="mt-0.5 text-xs sm:text-sm text-foreground-muted">
                      {authorLabel}: <strong class="font-semibold text-foreground">{agent.author}</strong>
                    </p>
                  </div>
                </div>
              </div>

              <p class="text-sm sm:text-base text-foreground leading-relaxed">
                {agent.purpose}
              </p>

              {agent.bullets && agent.bullets.length > 0 && (
                <ul class="mt-4 grid gap-2.5 sm:grid-cols-2">
                  {agent.bullets.map((bullet) => (
                    <li class="flex items-start gap-2 rounded-xl border border-brand-500/20 bg-background-secondary/70 p-3 text-xs sm:text-sm text-foreground">
                      <Icon name="check-circle-2" size="sm" class="mt-0.5 text-brand-500 shrink-0" />
                      <span class="leading-snug">{bullet}</span>
                    </li>
                  ))}
                </ul>
              )}
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>
)}

<style>
  @keyframes agent-float {
    0%, 100% {
      transform: translateY(0px);
    }
    50% {
      transform: translateY(-6px);
    }
  }

  .agent-cloud-pill {
    animation: agent-float 5.5s ease-in-out infinite;
    animation-delay: var(--float-delay, 0s);
  }

  .agent-cloud-pill:hover,
  .agent-cloud-pill[data-active="true"] {
    animation-play-state: paused;
  }

  /* Overlapping grid stack: all panels occupy row 1 / col 1 so the stage
     keeps a constant height (sized to the tallest card) and never shifts
     the page scroll when switching between agents. */
  .agent-spotlight {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateY(8px) scale(0.985);
    transition:
      opacity 320ms cubic-bezier(0.22, 1, 0.36, 1),
      transform 320ms cubic-bezier(0.22, 1, 0.36, 1),
      visibility 0ms linear 320ms;
  }

  .agent-spotlight[data-active="true"] {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateY(0) scale(1);
    transition:
      opacity 320ms cubic-bezier(0.22, 1, 0.36, 1),
      transform 320ms cubic-bezier(0.22, 1, 0.36, 1),
      visibility 0ms linear 0ms;
  }

  @media (prefers-reduced-motion: reduce) {
    .agent-cloud-pill {
      animation: none;
    }
    .agent-spotlight,
    .agent-spotlight[data-active="true"] {
      transition: none;
      transform: none;
    }
  }
</style>

<script>
  function initAgentsCloud() {
    const sections = document.querySelectorAll<HTMLElement>(
      '[data-agents-section]:not([data-agents-init])'
    );

    sections.forEach((section) => {
      section.setAttribute('data-agents-init', 'true');

      const triggers = Array.from(
        section.querySelectorAll<HTMLButtonElement>('[data-agent-trigger]')
      );
      const panels = Array.from(
        section.querySelectorAll<HTMLElement>('[data-agent-panel]')
      );
      const nodes = Array.from(
        section.querySelectorAll<HTMLElement>('[data-agent-node]')
      );

      let hoverTimer: number | undefined;

      const activateAgent = (targetIndex: number) => {
        triggers.forEach((btn, idx) => {
          const isActive = idx === targetIndex;
          btn.dataset.active = isActive ? 'true' : 'false';
          btn.setAttribute('aria-selected', isActive ? 'true' : 'false');
        });

        panels.forEach((panel, idx) => {
          const isActive = idx === targetIndex;
          panel.dataset.active = isActive ? 'true' : 'false';
          panel.setAttribute('aria-hidden', isActive ? 'false' : 'true');
        });
      };

      triggers.forEach((btn, idx) => {
        btn.addEventListener('click', () => {
          if (hoverTimer) window.clearTimeout(hoverTimer);
          activateAgent(idx);
        });

        btn.addEventListener('mouseenter', () => {
          if (hoverTimer) window.clearTimeout(hoverTimer);
          hoverTimer = window.setTimeout(() => {
            activateAgent(idx);
          }, 90);
        });

        btn.addEventListener('mouseleave', () => {
          if (hoverTimer) window.clearTimeout(hoverTimer);
        });
      });

      // Keep the spotlight stage synced if the user filters agents via the search bar
      const observer = new MutationObserver(() => {
        const visibleIndices = nodes
          .map((node, idx) => (!node.classList.contains('hidden') ? idx : -1))
          .filter((idx) => idx !== -1);

        if (visibleIndices.length > 0) {
          const currentActive = triggers.findIndex((t) => t.dataset.active === 'true');
          if (!visibleIndices.includes(currentActive)) {
            activateAgent(visibleIndices[0]);
          }
        }
      });

      nodes.forEach((node) => {
        observer.observe(node, { attributes: true, attributeFilter: ['class'] });
      });
    });
  }

  initAgentsCloud();
  document.addEventListener('astro:after-swap', initAgentsCloud);
</script>
