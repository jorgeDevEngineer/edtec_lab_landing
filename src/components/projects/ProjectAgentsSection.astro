---
/**
 * ProjectAgentsSection — interactive planetary orbit ("Turntable") of
 * specialized academic AI agents.
 *
 * Layout & Interaction:
 * - Left column (`lg:col-span-6`): A genuine 2D/3D planetary orbit where the 5
 *   agents sit at 72° intervals around a central core. Clicking any agent or
 *   pressing Anterior / Siguiente rotates the entire orbit smoothly so the
 *   selected agent comes to the front/focus position (`slot 0`: closest,
 *   largest, full opacity) while the previous agent recedes along the orbital
 *   ring into the background (smaller scale, lower opacity, deeper z-index).
 * - Right column (`lg:col-span-6`): Fixed-height stacked Spotlight Stage where
 *   all 5 agent detail cards share `col-start-1 row-start-1`, cross-fading in
 *   place with zero layout shift or page scroll jump.
 * - Mobile (`< sm`): Proportional orbital radius (`--rx: 108px`, `--ry: 86px`)
 *   so the full planetary ring fits inside narrow viewports without overflow,
 *   with Anterior/Siguiente controls right below the ring and the detail card
 *   underneath.
 */
import Icon from '@/components/ui/primitives/Icon/Icon.astro';
import { t, tData, defaultLocale } from '@/i18n';

interface AgentItem {
  name: string;
  author: string;
  icon: string;
  domain: string;
  purpose: string;
  bullets?: string[];
}

interface Props {
  locale?: string;
  showHeader?: boolean;
}

const { locale = defaultLocale, showHeader = false } = Astro.props;

const agents = tData<AgentItem[]>('projects.agents.items', locale) ?? [];
const authorLabel = t('projects.agents.authorLabel', locale);
const prevLabel = t('common.previous', locale);
const nextLabel = t('common.next', locale);
---

{agents.length > 0 && (
  <section
    class="agents-orbit-section relative overflow-hidden py-8 sm:py-12 lg:py-14 bg-background-secondary border-t border-border"
    data-agents-section
  >
    <!-- Ambient atmospheric nebula backdrop -->
    <div
      class="pointer-events-none absolute inset-0 overflow-hidden"
      aria-hidden="true"
    >
      <div class="
        absolute left-1/4 top-1/2 -translate-x-1/2 -translate-y-1/2
        h-[26rem] w-[42rem] rounded-full
        bg-gradient-to-r from-brand-500/10 via-brand-400/15 to-brand-500/10
        blur-3xl dark:from-brand-500/15 dark:via-brand-400/20 dark:to-brand-500/15
      " />
    </div>

    <div class="relative z-10 mx-auto max-w-6xl px-4 sm:px-6">
      {showHeader && (
        <div class="mx-auto max-w-2xl text-center mb-8" data-reveal>
          <h2 class="font-display text-3xl sm:text-4xl font-bold tracking-tight text-foreground mb-3">
            {t('projects.agents.title', locale)}
          </h2>
          <p class="text-sm sm:text-base text-foreground-muted leading-relaxed">
            {t('projects.agents.lead', locale)}
          </p>
        </div>
      )}

      <!-- Side-by-side on desktop (Planetary Orbit left, Spotlight description right) -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-center">
        <!-- Left column: Interactive Planetary Orbit + Turntable Controls -->
        <div class="lg:col-span-6 flex flex-col items-center">
          <div
            class="orbit-stage relative w-full h-[290px] sm:h-[360px] lg:h-[400px] flex items-center justify-center select-none"
            role="tablist"
            aria-label={t('projects.agents.title', locale)}
            data-agents-cloud
          >
            <!-- Outer & Inner Orbital Tracks -->
            <div class="orbit-ring-outer pointer-events-none absolute rounded-[100%] border border-dashed border-brand-500/30 dark:border-brand-400/25" aria-hidden="true" />
            <div class="orbit-ring-inner pointer-events-none absolute rounded-[100%] border border-brand-500/15 dark:border-brand-400/10" aria-hidden="true" />

            <!-- Central Planet & Nebula Cloud -->
            <div
              class="orbit-planet-wrap pointer-events-none relative z-10 flex items-center justify-center h-24 w-24 sm:h-28 sm:w-28"
              aria-hidden="true"
            >
              <!-- Soft atmospheric nebula cloud halo -->
              <div class="absolute -inset-4 rounded-full bg-brand-500/20 blur-xl animate-pulse" />
              <div class="absolute -inset-1 rounded-full bg-gradient-to-tr from-brand-500/25 via-brand-400/15 to-transparent blur-md" />

              <!-- Planet sphere with continents/atmosphere bands -->
              <div class="orbit-planet-sphere relative h-16 w-16 sm:h-20 sm:w-20 rounded-full overflow-hidden border border-brand-400/40 shadow-2xl bg-gradient-to-br from-brand-400 via-brand-600 to-brand-900">
                <!-- Atmospheric cloud bands across the planet -->
                <div class="absolute inset-0 opacity-35 bg-[radial-gradient(circle_at_30%_25%,rgba(255,255,255,0.65),transparent_55%)]" />
                <div class="absolute top-[28%] -left-2 right-2 h-2.5 rounded-full bg-white/20 blur-[1px] -rotate-12" />
                <div class="absolute top-[55%] left-3 -right-2 h-3 rounded-full bg-brand-200/25 blur-[1px] -rotate-12" />
                <div class="absolute bottom-[18%] -left-1 right-4 h-2 rounded-full bg-white/15 blur-[1px] -rotate-12" />
                <!-- Inner shadow for 3D spherical depth -->
                <div class="absolute inset-0 rounded-full shadow-[inset_-10px_-10px_20px_rgba(0,0,0,0.55),inset_4px_4px_10px_rgba(255,255,255,0.25)]" />
              </div>

              <!-- Tilted planetary ring passing around the planet -->
              <div class="pointer-events-none absolute w-28 sm:w-36 h-8 sm:h-10 rounded-[100%] border-2 border-brand-300/45 dark:border-brand-300/35 -rotate-[22deg] shadow-[0_0_15px_rgba(59,130,246,0.25)]" />
            </div>

            <!-- Orbiting Agent Nodes -->
            {agents.map((agent, index) => (
              <div
                class="agent-orbit-node"
                data-slot={index}
                data-project-card
                data-project-title={agent.name}
                data-agent-node={index}
              >
                <button
                  type="button"
                  role="tab"
                  aria-selected={index === 0 ? 'true' : 'false'}
                  aria-controls={`agent-panel-${index}`}
                  id={`agent-tab-${index}`}
                  data-agent-trigger={index}
                  data-active={index === 0 ? 'true' : 'false'}
                  class="
                    agent-orbit-pill group relative flex items-center gap-2.5 sm:gap-3
                    rounded-full px-3.5 py-2 sm:px-4.5 sm:py-2.5
                    bg-card/95 backdrop-blur-md
                    border border-brand-500/30
                    shadow-md hover:shadow-xl
                    transition-colors duration-300 cursor-pointer
                    hover:border-brand-500
                    data-[active=true]:border-brand-500
                    data-[active=true]:bg-brand-500/15
                    data-[active=true]:dark:bg-brand-500/25
                    data-[active=true]:shadow-2xl
                    data-[active=true]:ring-2
                    data-[active=true]:ring-brand-500/40
                    focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500
                  "
                >
                  <span class="
                    flex h-8 w-8 sm:h-9 sm:w-9 shrink-0 items-center justify-center rounded-full
                    bg-gradient-to-br from-brand-500/20 to-brand-500/5
                    text-brand-500 border border-brand-500/25
                    transition-all duration-300
                    group-hover:scale-105
                    group-data-[active=true]:bg-brand-500
                    group-data-[active=true]:text-white
                    group-data-[active=true]:border-brand-500
                  ">
                    <Icon name={agent.icon} size="sm" />
                  </span>

                  <div class="text-left pr-1">
                    <span class="block font-display text-xs sm:text-sm font-bold text-foreground leading-tight whitespace-nowrap">
                      {agent.name}
                    </span>
                    <span class="hidden sm:block text-[11px] text-foreground-muted mt-0.5 whitespace-nowrap">
                      {agent.author}
                    </span>
                  </div>
                </button>
              </div>
            ))}
          </div>

          <!-- Orbital Rotation Controls (Prev / Counter / Next) -->
          <div class="mt-2 flex items-center gap-3">
            <button
              type="button"
              data-orbit-prev
              aria-label={prevLabel}
              class="
                inline-flex items-center gap-1.5 rounded-full
                border border-brand-500/30 bg-card/90 px-3.5 py-1.5
                text-xs font-medium text-foreground shadow-sm
                hover:border-brand-500 hover:bg-brand-500/10
                transition-all cursor-pointer
                focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500
              "
            >
              <Icon name="arrow-left" size="xs" />
              <span>Anterior</span>
            </button>

            <div class="flex items-center gap-1.5 px-2" aria-hidden="true">
              {agents.map((_, idx) => (
                <span
                  data-orbit-dot={idx}
                  data-active={idx === 0 ? 'true' : 'false'}
                  class="
                    h-2 rounded-full transition-all duration-300
                    w-2 bg-brand-500/30
                    data-[active=true]:w-6 data-[active=true]:bg-brand-500
                  "
                />
              ))}
            </div>

            <button
              type="button"
              data-orbit-next
              aria-label={nextLabel}
              class="
                inline-flex items-center gap-1.5 rounded-full
                border border-brand-500/30 bg-card/90 px-3.5 py-1.5
                text-xs font-medium text-foreground shadow-sm
                hover:border-brand-500 hover:bg-brand-500/10
                transition-all cursor-pointer
                focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500
              "
            >
              <span>Siguiente</span>
              <Icon name="arrow-right" size="xs" />
            </button>
          </div>
        </div>

        <!-- Right column: Fixed-height stacked Spotlight Stage (zero layout shift, smooth fade/pop) -->
        <div
          class="lg:col-span-6 agent-stage-stack relative grid items-center"
          data-agents-stage
        >
          {agents.map((agent, index) => (
            <div
              id={`agent-panel-${index}`}
              role="tabpanel"
              aria-labelledby={`agent-tab-${index}`}
              aria-hidden={index === 0 ? 'false' : 'true'}
              data-agent-panel={index}
              data-active={index === 0 ? 'true' : 'false'}
              class="
                agent-spotlight col-start-1 row-start-1
                rounded-2xl sm:rounded-3xl border border-brand-500/30 bg-card/95 backdrop-blur-xl
                p-5 sm:p-7 lg:p-8 shadow-xl
              "
            >
              <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-4 mb-4 border-b border-border">
                <div class="flex items-center gap-3.5">
                  <div class="flex h-11 w-11 sm:h-13 sm:w-13 shrink-0 items-center justify-center rounded-2xl bg-brand-500/15 text-brand-500 border border-brand-500/30">
                    <Icon name={agent.icon} size="md" />
                  </div>
                  <div>
                    <div class="flex flex-wrap items-center gap-2">
                      <h2 class="font-display text-xl sm:text-2xl font-bold text-foreground">
                        {agent.name}
                      </h2>
                      <span class="inline-flex items-center rounded-full bg-brand-500/10 px-2.5 py-0.5 text-xs font-medium text-brand-700 dark:text-brand-300 border border-brand-500/20">
                        {agent.domain}
                      </span>
                    </div>
                    <p class="mt-0.5 text-xs sm:text-sm text-foreground-muted">
                      {authorLabel}: <strong class="font-semibold text-foreground">{agent.author}</strong>
                    </p>
                  </div>
                </div>
              </div>

              <p class="text-sm sm:text-base text-foreground leading-relaxed">
                {agent.purpose}
              </p>

              {agent.bullets && agent.bullets.length > 0 && (
                <ul class="mt-4 grid gap-2.5 sm:grid-cols-2">
                  {agent.bullets.map((bullet) => (
                    <li class="flex items-start gap-2 rounded-xl border border-brand-500/20 bg-background-secondary/70 p-3 text-xs sm:text-sm text-foreground">
                      <Icon name="check-circle-2" size="sm" class="mt-0.5 text-brand-500 shrink-0" />
                      <span class="leading-snug">{bullet}</span>
                    </li>
                  ))}
                </ul>
              )}
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>
)}

<style>
  /* Responsive orbital radii so all 5 nodes form a true 2D/3D planetary ring
     without overflowing narrow mobile screens */
  .orbit-stage {
    --rx: 102px;
    --ry: 96px;
  }

  @media (min-width: 640px) {
    .orbit-stage {
      --rx: 168px;
      --ry: 128px;
    }
  }

  @media (min-width: 1024px) {
    .orbit-stage {
      --rx: 175px;
      --ry: 142px;
    }
  }

  .orbit-ring-outer {
    width: calc(var(--rx) * 2.05);
    height: calc(var(--ry) * 2.05);
  }

  .orbit-ring-inner {
    width: calc(var(--rx) * 1.25);
    height: calc(var(--ry) * 1.25);
  }

  .agent-orbit-node {
    position: absolute;
    left: 50%;
    top: 50%;
    transition:
      transform 650ms cubic-bezier(0.22, 1, 0.36, 1),
      opacity 650ms cubic-bezier(0.22, 1, 0.36, 1),
      filter 650ms cubic-bezier(0.22, 1, 0.36, 1);
    will-change: transform, opacity;
  }

  /* Slot 0: Front / Active Planet (closest to the detail card on desktop, foreground) */
  .agent-orbit-node[data-slot="0"] {
    transform: translate(-50%, -50%)
      translate3d(calc(var(--rx) * 0.92), calc(var(--ry) * 0.12), 0)
      scale(1.1);
    z-index: 30;
    opacity: 1;
    filter: none;
  }

  /* Slot 1: Bottom-Right / Front-Lower Orbit */
  .agent-orbit-node[data-slot="1"] {
    transform: translate(-50%, -50%)
      translate3d(calc(var(--rx) * 0.15), calc(var(--ry) * 0.98), 0)
      scale(0.95);
    z-index: 24;
    opacity: 0.9;
    filter: brightness(0.95);
  }

  /* Slot 2: Bottom-Left / Receding Back Orbit */
  .agent-orbit-node[data-slot="2"] {
    transform: translate(-50%, -50%)
      translate3d(calc(var(--rx) * -0.88), calc(var(--ry) * 0.56), 0)
      scale(0.84);
    z-index: 15;
    opacity: 0.68;
    filter: brightness(0.85);
  }

  /* Slot 3: Top-Left / Far Back Orbit */
  .agent-orbit-node[data-slot="3"] {
    transform: translate(-50%, -50%)
      translate3d(calc(var(--rx) * -0.84), calc(var(--ry) * -0.62), 0)
      scale(0.84);
    z-index: 14;
    opacity: 0.68;
    filter: brightness(0.85);
  }

  /* Slot 4: Top-Right / Approaching Orbit */
  .agent-orbit-node[data-slot="4"] {
    transform: translate(-50%, -50%)
      translate3d(calc(var(--rx) * 0.22), calc(var(--ry) * -0.96), 0)
      scale(0.95);
    z-index: 25;
    opacity: 0.9;
    filter: brightness(0.95);
  }

  /* Overlapping grid stack: all panels occupy row 1 / col 1 so the stage
     keeps a constant height (sized to the tallest card) and never shifts
     the page scroll when switching between agents. */
  .agent-spotlight {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateY(8px) scale(0.985);
    transition:
      opacity 360ms cubic-bezier(0.22, 1, 0.36, 1),
      transform 360ms cubic-bezier(0.22, 1, 0.36, 1),
      visibility 0ms linear 360ms;
  }

  .agent-spotlight[data-active="true"] {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateY(0) scale(1);
    transition:
      opacity 360ms cubic-bezier(0.22, 1, 0.36, 1),
      transform 360ms cubic-bezier(0.22, 1, 0.36, 1),
      visibility 0ms linear 0ms;
  }

  @media (prefers-reduced-motion: reduce) {
    .agent-orbit-node,
    .agent-spotlight,
    .agent-spotlight[data-active="true"] {
      transition: none;
    }
  }
</style>

<script>
  function initAgentsOrbit() {
    const sections = document.querySelectorAll<HTMLElement>(
      '[data-agents-section]:not([data-agents-init])'
    );

    sections.forEach((section) => {
      section.setAttribute('data-agents-init', 'true');

      const triggers = Array.from(
        section.querySelectorAll<HTMLButtonElement>('[data-agent-trigger]')
      );
      const panels = Array.from(
        section.querySelectorAll<HTMLElement>('[data-agent-panel]')
      );
      const nodes = Array.from(
        section.querySelectorAll<HTMLElement>('[data-agent-node]')
      );
      const dots = Array.from(
        section.querySelectorAll<HTMLElement>('[data-orbit-dot]')
      );
      const prevBtn = section.querySelector<HTMLButtonElement>('[data-orbit-prev]');
      const nextBtn = section.querySelector<HTMLButtonElement>('[data-orbit-next]');

      const total = triggers.length;
      if (total === 0) return;

      let activeIndex = 0;

      const activateAgent = (targetIndex: number) => {
        activeIndex = ((targetIndex % total) + total) % total;

        triggers.forEach((btn, idx) => {
          const isActive = idx === activeIndex;
          btn.dataset.active = isActive ? 'true' : 'false';
          btn.setAttribute('aria-selected', isActive ? 'true' : 'false');
        });

        // Rotate every planet around the orbit ring relative to the newly active agent
        nodes.forEach((node, idx) => {
          const slot = (idx - activeIndex + total) % total;
          node.setAttribute('data-slot', String(slot));
        });

        panels.forEach((panel, idx) => {
          const isActive = idx === activeIndex;
          panel.dataset.active = isActive ? 'true' : 'false';
          panel.setAttribute('aria-hidden', isActive ? 'false' : 'true');
        });

        dots.forEach((dot, idx) => {
          dot.dataset.active = idx === activeIndex ? 'true' : 'false';
        });
      };

      triggers.forEach((btn, idx) => {
        btn.addEventListener('click', () => {
          activateAgent(idx);
        });
      });

      prevBtn?.addEventListener('click', () => {
        activateAgent(activeIndex - 1);
      });

      nextBtn?.addEventListener('click', () => {
        activateAgent(activeIndex + 1);
      });

      // Keyboard arrow support when focused inside the orbit tablist
      section.addEventListener('keydown', (e: KeyboardEvent) => {
        if (e.key === 'ArrowRight' || e.key === 'ArrowDown') {
          const activeEl = document.activeElement;
          if (activeEl && section.contains(activeEl) && activeEl.hasAttribute('data-agent-trigger')) {
            e.preventDefault();
            const nextIdx = (activeIndex + 1) % total;
            activateAgent(nextIdx);
            triggers[nextIdx]?.focus();
          }
        } else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') {
          const activeEl = document.activeElement;
          if (activeEl && section.contains(activeEl) && activeEl.hasAttribute('data-agent-trigger')) {
            e.preventDefault();
            const prevIdx = (activeIndex - 1 + total) % total;
            activateAgent(prevIdx);
            triggers[prevIdx]?.focus();
          }
        }
      });
    });
  }

  initAgentsOrbit();
  document.addEventListener('astro:after-swap', initAgentsOrbit);
</script>
