---
/**
 * ProjectSearchBar — client-side live filter by project name for project listings.
 */
import Input from '@/components/ui/form/Input/Input.astro';
import { t, defaultLocale } from '@/i18n';

interface Props {
  locale?: string;
}

const { locale = defaultLocale } = Astro.props;
---

<div class="project-search-bar w-full max-w-md mx-auto" data-project-search-wrap>
  <Input
    type="search"
    size="md"
    leadingIcon="search"
    placeholder={t('projects.searchPlaceholder', locale)}
    aria-label={t('projects.searchAriaLabel', locale)}
    autocomplete="off"
    data-project-search-input
  />
</div>

<style>
  .project-search-bar :global(input[data-project-search-input]) {
    background-color: #ffffff !important;
    color: #0f172a !important;
    border-color: #cbd5e1 !important;
    box-shadow: 0 4px 14px -2px rgba(0, 0, 0, 0.08);
  }

  .project-search-bar :global(input[data-project-search-input]::placeholder) {
    color: #64748b !important;
  }

  .project-search-bar :global(.text-foreground-muted) {
    color: #475569 !important;
  }
</style>

<script>
  function normalizeText(value: string): string {
    return value
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '')
      .toLowerCase()
      .trim();
  }

  function initProjectSearch() {
    const inputs = document.querySelectorAll<HTMLInputElement>(
      '[data-project-search-input]:not([data-search-initialized])'
    );

    inputs.forEach((input) => {
      input.setAttribute('data-search-initialized', 'true');

      const root = input.closest('main') ?? document;
      const cards = Array.from(
        root.querySelectorAll<HTMLElement>('[data-project-card]')
      );
      const emptyState = root.querySelector<HTMLElement>('[data-project-search-empty]');
      const pagination = root.querySelector<HTMLElement>('[data-project-pagination]');

      const applyFilter = () => {
        const query = normalizeText(input.value);
        let visibleCount = 0;

        cards.forEach((card) => {
          const title = normalizeText(card.dataset.projectTitle ?? '');
          const matches = query === '' || title.includes(query);

          if (matches) {
            card.classList.remove('hidden');
            visibleCount++;
          } else {
            card.classList.add('hidden');
          }
        });

        if (emptyState) {
          emptyState.classList.toggle('hidden', visibleCount > 0);
        }

        if (pagination) {
          pagination.classList.toggle('hidden', query !== '');
        }
      };

      input.addEventListener('input', applyFilter);
      input.addEventListener('search', applyFilter);

      if (input.value) {
        applyFilter();
      }
    });
  }

  initProjectSearch();
  document.addEventListener('astro:after-swap', initProjectSearch);
</script>
