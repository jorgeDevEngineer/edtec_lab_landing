---
/**
 * Project listing card. Extracted so the projects index, paginated pages,
 * and tag archives render identical cards from one source of truth.
 *
 * Placeholder projects render as a non-interactive card (no link), matching
 * how the listing treats projects that don't have their own detail page.
 */
import Card from '@/components/ui/data-display/Card/Card.astro';
import Icon from '@/components/ui/primitives/Icon/Icon.astro';
import type { CollectionEntry } from 'astro:content';
import { defaultLocale } from '@/i18n';
import { getProjectUrl } from '@/lib/projects';

interface Props {
  project: CollectionEntry<'projects'>;
  /** Stagger index for the scroll-reveal cascade. */
  index?: number;
  /**
   * Locale the card's link belongs to. Default-locale links stay at
   * `/projects/...`; other locales are prefixed (`/<locale>/projects/...`).
   */
  locale?: string;
  /**
   * Add the scroll-reveal trigger. Turn it off where a parent already reveals
   * the whole section — nesting one reveal inside another leaves the cards
   * waiting on a trigger that has already fired.
   */
  reveal?: boolean;
  /**
   * Layout presentation:
   * - 'featured': elongated wide card with highlighted banner/badge and horizontal layout on tablet+
   * - 'standard': regular vertical card
   */
  variant?: 'featured' | 'standard';
}

const { project, index = 0, locale = defaultLocale, reveal = true, variant = 'standard' } = Astro.props;
const { data } = project;
const isFeatured = variant === 'featured';
---

<Card
  variant="elevated"
  hover
  padding="none"
  href={data.placeholder ? undefined : getProjectUrl(project.id, locale)}
  class:list={[
    'group relative flex flex-col overflow-hidden transition-all duration-300 ease-out hover:-translate-y-1 hover:shadow-2xl hover:border-brand-500/80',
    isFeatured ? 'md:col-span-2' : ''
  ]}
  data-reveal={reveal || undefined}
  data-reveal-delay={reveal ? index % 2 || undefined : undefined}
>
  <!-- Interactive background subtle glow on hover -->
  <div class="pointer-events-none absolute -right-20 -top-20 h-48 w-48 rounded-full bg-brand-500/10 blur-3xl transition-opacity duration-500 opacity-0 group-hover:opacity-100 dark:bg-brand-500/20" aria-hidden="true" />

  <div class="flex flex-1 flex-col p-6 sm:p-8">
    <div class="flex flex-col flex-1">
      <!-- Top header line: Year & Featured badge / arrow -->
      <div class="mb-4 flex items-center justify-between gap-4">
        <div class="flex items-center gap-2.5">
          {isFeatured && (
            <span class="inline-flex items-center gap-1.5 rounded-full bg-brand-500/10 px-2.5 py-0.5 text-xs font-semibold uppercase tracking-wider text-brand-600 dark:text-brand-400 border border-brand-500/20">
              <Icon name="sparkles" size="xs" />
              Iniciativa Destacada
            </span>
          )}
          {data.year && (
            <span class="text-xs font-medium text-foreground-muted">{data.year}</span>
          )}
        </div>

        <div class="flex items-center justify-center w-8 h-8 rounded-full bg-background-secondary text-foreground-muted group-hover:bg-brand-500 group-hover:text-white transition-all duration-300 transform group-hover:rotate-45 shrink-0">
          <Icon name="arrow-up-right" size="xs" />
        </div>
      </div>

      <!-- Icon & Title -->
      <div class:list={[
        'mb-3 flex items-center gap-3.5',
        !isFeatured ? 'flex-col text-center mt-2' : 'flex-row'
      ]}>
        <div class="w-12 h-12 rounded-2xl bg-gradient-to-br from-brand-500/20 to-brand-500/5 flex items-center justify-center text-brand-500 shrink-0 shadow-sm border border-brand-500/20 group-hover:scale-110 group-hover:border-brand-500/50 transition-all duration-300">
          <Icon name={data.icon ?? 'layers'} class="w-6 h-6 text-brand-500" />
        </div>
        <div>
          <h2 class:list={[
            'font-display font-bold text-foreground transition-colors group-hover:text-brand-600 dark:group-hover:text-brand-400',
            isFeatured ? 'text-xl sm:text-2xl' : 'text-lg sm:text-xl'
          ]}>
            {data.title}
          </h2>
          {isFeatured && data.role && (
            <span class="text-xs text-foreground-muted">{data.role}</span>
          )}
        </div>
      </div>

      <!-- Description -->
      <p class:list={[
        'text-sm text-foreground-muted leading-relaxed mb-5',
        !isFeatured ? 'text-center flex-1' : 'line-clamp-3'
      ]}>
        {data.description}
      </p>

      <!-- Tags -->
      {data.tags && data.tags.length > 0 && (
        <div class:list={[
          'flex flex-wrap gap-1.5',
          !isFeatured ? 'justify-center mt-auto' : 'justify-start'
        ]}>
          {data.tags.map((tag) => (
            <span class="inline-flex items-center rounded-full bg-background-secondary px-2.5 py-0.5 text-xs font-medium text-brand-700 dark:text-brand-400 ring-1 ring-inset ring-brand-500/30 transition-all duration-200 group-hover:ring-brand-500/70 group-hover:bg-brand-500/10">
              #{tag}
            </span>
          ))}
        </div>
      )}
    </div>
  </div>
</Card>
