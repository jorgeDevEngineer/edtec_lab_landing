---
/**
 * ThemeModeDropdown / ThemeToggle
 * 2-state direct dark/light toggle with a 360-degree rotation animation.
 * Replaces the old combobox popup completely.
 */
import { cn } from '@/lib/cn';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div class={cn('relative inline-flex items-center', className)}>
  <button
    type="button"
    id="theme-spin-toggle"
    class="theme-spin-btn inline-flex items-center justify-center rounded-full border border-border-strong p-1.5 text-foreground-muted hover:text-foreground hover:bg-secondary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 transition-colors duration-200"
    aria-label="Cambiar modo claro / oscuro"
    title="Cambiar modo claro / oscuro"
  >
    <span class="theme-icon-container relative flex items-center justify-center h-4 w-4">
      <!-- Sun icon: visible in dark mode (click to go to light) -->
      <svg
        class="theme-icon theme-icon-sun absolute h-4 w-4"
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="2"
        aria-hidden="true"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M12 3v2.25m6.364.386l-1.591 1.591M21 12h-2.25m-.386 6.364l-1.591-1.591M12 18.75V21m-4.773-4.227l-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0z"
        />
      </svg>

      <!-- Moon icon: visible in light mode (click to go to dark) -->
      <svg
        class="theme-icon theme-icon-moon absolute h-4 w-4"
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="2"
        aria-hidden="true"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M21.752 15.002A9.718 9.718 0 0118 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 003 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 009.002-5.998z"
        />
      </svg>
    </span>
  </button>
</div>

<style>
  .theme-icon-container {
    transition: transform 0.5s cubic-bezier(0.4, 0, 0.2, 1);
  }

  /* 360 spin animation trigger class */
  .theme-spin-btn.is-spinning .theme-icon-container {
    transform: rotate(360deg);
  }

  .theme-icon {
    transition: opacity 0.3s ease, transform 0.3s ease;
  }

  /* When dark mode is active: show Sun icon */
  :global(html.dark) .theme-icon-sun {
    opacity: 1;
    transform: scale(1);
    pointer-events: auto;
  }
  :global(html.dark) .theme-icon-moon {
    opacity: 0;
    transform: scale(0.4);
    pointer-events: none;
  }

  /* When light mode is active: show Moon icon */
  :global(html:not(.dark)) .theme-icon-sun {
    opacity: 0;
    transform: scale(0.4);
    pointer-events: none;
  }
  :global(html:not(.dark)) .theme-icon-moon {
    opacity: 1;
    transform: scale(1);
    pointer-events: auto;
  }
</style>

<script>
  function isCurrentDark(): boolean {
    return document.documentElement.classList.contains('dark');
  }

  function applyMode(dark: boolean): void {
    const root = document.documentElement;
    root.setAttribute('data-theme-mode', dark ? 'dark' : 'light');
    root.classList.toggle('dark', dark);
    try {
      localStorage.setItem('theme', dark ? 'dark' : 'light');
    } catch {
      /* ignore */
    }
  }

  function setupSpinToggles(): void {
    const buttons = document.querySelectorAll<HTMLButtonElement>('.theme-spin-btn');
    buttons.forEach((btn) => {
      if (btn.dataset.spinInit) return;
      btn.dataset.spinInit = 'true';

      btn.addEventListener('click', () => {
        // Trigger 360 spin animation
        btn.classList.remove('is-spinning');
        // Force reflow
        void btn.offsetWidth;
        btn.classList.add('is-spinning');

        // Toggle theme immediately
        const nextDark = !isCurrentDark();
        applyMode(nextDark);

        setTimeout(() => {
          btn.classList.remove('is-spinning');
        }, 520);
      });
    });
  }

  setupSpinToggles();
  document.addEventListener('astro:after-swap', setupSpinToggles);
</script>
